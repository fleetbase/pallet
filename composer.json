{
    "name": "fleetbase/pallet-api",
    "version": "0.0.2",
    "description": "Inventory & Warehouse Management Extension for Fleetbase",
    "keywords": [
        "fleetbase",
        "fleetbase-extension",
        "inventory",
        "inventory management",
        "stock management",
        "ecommerce",
        "inventory management api",
        "inventory system"
    ],
    "license": "AGPL-3.0-or-later",
    "authors": [
        {
            "name": "Fleetbase Pte Ltd.",
            "email": "hello@fleetbase.io"
        },
        {
            "name": "Ronald A. Richardson",
            "email": "ron@fleetbase.io"
        }
    ],
    "require": {
        "php": "^8.2",
        "fleetbase/core-api": "^2.0",
        "fleetbase/fleetops-api": "^0.7.0",
        "php-http/guzzle7-adapter": "^1.0",
        "psr/http-factory-implementation": "*"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.34.1",
        "larastan/larastan": "^3.0",
        "nunomaduro/collision": "^8.0",
        "orchestra/testbench": "^10.0",
        "pestphp/pest": "^3.0",
        "phpstan/phpstan": "^2.0",
        "symfony/var-dumper": "^7.0"
    },
    "autoload": {
        "psr-4": {
            "Fleetbase\\Pallet\\": "server/src/",
            "Fleetbase\\Pallet\\Seeds\\": "server/seeds/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Fleetbase\\Pallet\\Tests\\": "server/tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "extra": {
        "laravel": {
            "providers": [
                "Fleetbase\\Pallet\\Providers\\PalletServiceProvider"
            ]
        },
        "fleetbase": {
            "sandbox-migrations": false
        }
    },
    "config": {
        "vendor-dir": "./server_vendor",
        "sort-packages": true,
        "preferred-install": "dist",
        "process-timeout": 1800,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "scripts": {
        "lint": "php-cs-fixer fix -v --dry-run",
        "lint:fix": "php-cs-fixer fix -v",
        "test:lint": "@lint",
        "test:types": "server_vendor/bin/phpstan analyse --ansi --memory-limit=1G",
        "test:unit": [
            "@php -r \"file_exists('vendor') || symlink('server_vendor', 'vendor');\"",
            "@php -d error_reporting=\"E_ALL & ~E_DEPRECATED\" -d xdebug.mode=off -d memory_limit=512M server_vendor/bin/pest --colors=always --test-directory server/tests"
        ],
        "test": [
            "@test:lint",
            "@test:types",
            "@test:unit"
        ]
    }
}
