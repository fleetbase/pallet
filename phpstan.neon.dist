includes:
    # Without this, PHPStan sees none of Eloquent: Model::where(), $model->uuid and
    # every relation read are undefined symbols. It reported 2752 errors at level max,
    # essentially all of them framework behaviour rather than defects.
    - server_vendor/larastan/larastan/extension.neon

parameters:
    # Level 1 is where "this method does not exist" and "this property does not exist"
    # are enforced. It has paid for itself three times over already: level 0 caught the
    # public sales order API importing a Contact class that does not exist, and level 1
    # caught SupplierFilter calling a method renamed out from under it (every search on
    # the suppliers list was fatal) plus six fields the API emitted that no model could
    # supply — including the product photo url the console reads in eleven places.
    #
    # It is a floor, not a ceiling. With larastan, the @property blocks on the models and
    # @mixin on the resources, the remaining counts are:
    #     level 2: 77   level 3: 230   level 4: 238   level 5: 238   level 6: 737
    # (down from 1865 / 1947 / 1953 / 1953 / 2476 before that work). Level 2 is largely
    # missing generics on iterables; levels 3-5 add argument and return type mismatches.
    #
    # There are deliberately no ignoreErrors. The six that were listed here have been
    # fixed rather than suppressed.
    level: 1

    paths:
        - server/src

    reportUnmatchedIgnoredErrors: true
