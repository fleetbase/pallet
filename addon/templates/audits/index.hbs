<Layout::Resource::Tabular
    @resource="audit"
    @title={{t "pallet.audit.title"}}
    @searchPlaceholder={{t "pallet.audit.search_placeholder"}}
    @searchQuery={{this.query}}
    @onSearch={{perform this.search}}
    @data={{@model}}
    @columns={{this.columns}}
    @page={{this.page}}
    @onPageChange={{fn (mut this.page)}}
    @setupTable={{fn (mut this.table)}}
    @controller={{this}}
    @canCreate={{false}}
    @canDelete={{false}}
>
    <:subheader>
        <div class="flex items-center space-x-2">
            {{!-- Event type filter --}}
            <BasicDropdown as |dd|>
                <dd.Trigger>
                    <button type="button" class="inline-flex items-center px-3 py-1.5 border border-gray-300 dark:border-gray-600 rounded text-sm font-medium text-gray-700 dark:text-gray-200 bg-white dark:bg-gray-800 hover:bg-gray-50 dark:hover:bg-gray-700">
                        {{#if this.event_type}}
                            {{t "pallet.audit.filter_event_type"}}: {{this.event_type}}
                        {{else}}
                            {{t "pallet.audit.all_events"}}
                        {{/if}}
                        <FaIcon @icon="chevron-down" class="ml-1 h-3 w-3" />
                    </button>
                </dd.Trigger>
                <dd.Content class="z-50 mt-1 bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-600 rounded shadow-lg min-w-max">
                    <ul class="py-1 text-sm text-gray-700 dark:text-gray-200">
                        {{#each this.eventTypeOptions as |opt|}}
                            <li>
                                <button
                                    type="button"
                                    class="w-full text-left px-4 py-2 hover:bg-gray-100 dark:hover:bg-gray-700 {{if (eq this.event_type opt.value) "font-semibold"}}"
                                    {{on "click" (fn this.filterByEventType opt.value)}}
                                >
                                    {{opt.label}}
                                </button>
                            </li>
                        {{/each}}
                    </ul>
                </dd.Content>
            </BasicDropdown>

            {{!-- Clear filters --}}
            {{#if (or this.event_type this.subject_type this.query)}}
                <button
                    type="button"
                    class="inline-flex items-center px-3 py-1.5 text-sm text-red-600 dark:text-red-400 hover:underline"
                    {{on "click" this.clearFilters}}
                >
                    <FaIcon @icon="times" class="mr-1 h-3 w-3" />
                    {{t "pallet.common.clear_filters"}}
                </button>
            {{/if}}
        </div>
    </:subheader>
</Layout::Resource::Tabular>

{{outlet}}
