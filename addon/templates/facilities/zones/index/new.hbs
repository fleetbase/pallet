<Layout::Resource::Panel
    class="pallet-overlay-fill"
    @resource={{this.zone}}
    @controller={{this}}
    @headerTitle="Create a new zone"
    @saveTask={{this.save}}
    @onPressCancel={{transition-to "facilities.zones.index"}}
    @onOverlayReady={{fn (mut this.overlay)}}
>
    <WarehouseZone::Form @resource={{this.zone}} @controller={{this}} />
    <Spacer @height="200px" />
</Layout::Resource::Panel>