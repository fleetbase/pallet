<Layout::Section::Header @title="Locations">
    <div class="text-sm text-gray-500 dark:text-gray-300">Manage warehouse bin locations used for receiving, storage, picking, transfers, and cycle counts.</div>
</Layout::Section::Header>

<Layout::Section::Body class="overflow-y-scroll h-full p-4">
    <ContentPanel @title="Create Bin Location" @open={{true}} @wrapperClass="bordered-classic mb-4">
        <div class="grid grid-cols-1 gap-3 text-xs lg:grid-cols-6">
            <InputGroup @name="Warehouse">
                <ModelSelect
                    @modelName="warehouse"
                    @selectedModel={{this.newLocation.warehouse}}
                    @placeholder="Warehouse"
                    @triggerClass="form-select form-input"
                    @infiniteScroll={{false}}
                    @renderInPlace={{true}}
                    @onChange={{this.setWarehouse}}
                    as |model|
                >
                    {{n-a model.name model.address}}
                </ModelSelect>
            </InputGroup>

            <InputGroup @name="Zone">
                <ModelSelect
                    @modelName="warehouse-zone"
                    @selectedModel={{this.newLocation.zone}}
                    @placeholder="Optional zone"
                    @triggerClass="form-select form-input"
                    @infiniteScroll={{false}}
                    @renderInPlace={{true}}
                    @onChange={{this.setZone}}
                    as |model|
                >
                    {{n-a model.name model.public_id}}
                </ModelSelect>
            </InputGroup>

            <InputGroup @name="Bin">
                <Input @value={{this.newLocation.bin_number}} class="w-full form-input" placeholder="A-01-01" />
            </InputGroup>

            <InputGroup @name="Type">
                <Input @value={{this.newLocation.type}} class="w-full form-input" placeholder="storage" />
            </InputGroup>

            <InputGroup @name="Capacity">
                <Input @value={{this.newLocation.capacity}} @type="number" class="w-full form-input" placeholder="0" />
            </InputGroup>

            <div class="flex items-end">
                <Button @icon="plus" @type="primary" @text="Create" @onClick={{this.createLocation}} @wrapperClass="w-full" />
            </div>
        </div>
    </ContentPanel>

    <ContentPanel @title="Bin Locations" @open={{true}} @wrapperClass="bordered-classic" @panelBodyWrapperClass="px-0i py-0i">
        <table class="w-full text-sm">
            <thead>
                <tr class="border-b border-gray-200 dark:border-gray-700 text-left text-xs uppercase text-gray-500">
                    <th class="px-4 py-3">Bin</th>
                    <th class="px-4 py-3">Warehouse</th>
                    <th class="px-4 py-3">Zone</th>
                    <th class="px-4 py-3">Type</th>
                    <th class="px-4 py-3">Status</th>
                    <th class="px-4 py-3 text-right">Available</th>
                </tr>
            </thead>
            <tbody>
                {{#each @model as |location|}}
                    <tr class="border-b border-gray-100 dark:border-gray-800">
                        <td class="px-4 py-3 font-medium">{{n-a location.bin_number}}</td>
                        <td class="px-4 py-3">{{n-a location.warehouse.name}}</td>
                        <td class="px-4 py-3">{{n-a location.zone.name}}</td>
                        <td class="px-4 py-3">{{n-a location.type}}</td>
                        <td class="px-4 py-3"><Badge @status={{if (eq location.status "active") "success" "default"}}>{{n-a location.status}}</Badge></td>
                        <td class="px-4 py-3 text-right">{{n-a location.available_capacity}}</td>
                    </tr>
                {{else}}
                    <tr><td colspan="6" class="px-4 py-8 text-center text-gray-500">No bin locations yet.</td></tr>
                {{/each}}
            </tbody>
        </table>
    </ContentPanel>
</Layout::Section::Body>
