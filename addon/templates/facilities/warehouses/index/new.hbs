<Layout::Resource::Panel
    @resource={{this.warehouse}}
    @controller={{this}}
    @headerTitle="Create a new warehouse"
    @saveTask={{this.save}}
    @onPressCancel={{transition-to "facilities.warehouses.index"}}
    @onOverlayReady={{fn (mut this.overlay)}}
>
    <Warehouse::Form @resource={{this.warehouse}} @controller={{this}} />
    <Spacer @height="200px" />
</Layout::Resource::Panel>