<Layout::Section::Header @title="Zones">
    <div class="text-sm text-gray-500 dark:text-gray-300">Manage storage, receiving, staging, quarantine, and outbound zones across warehouses.</div>
</Layout::Section::Header>

<Layout::Section::Body class="overflow-y-scroll h-full p-4">
    <ContentPanel @title="Warehouse Zones" @open={{true}} @wrapperClass="bordered-classic" @panelBodyWrapperClass="px-0i py-0i">
        <table class="w-full text-sm">
            <thead>
                <tr class="border-b border-gray-200 dark:border-gray-700 text-left text-xs uppercase text-gray-500">
                    <th class="px-4 py-3">Zone</th>
                    <th class="px-4 py-3">Warehouse</th>
                    <th class="px-4 py-3">Type</th>
                    <th class="px-4 py-3">Status</th>
                    <th class="px-4 py-3 text-right">Utilization</th>
                </tr>
            </thead>
            <tbody>
                {{#each @model as |zone|}}
                    <tr class="border-b border-gray-100 dark:border-gray-800">
                        <td class="px-4 py-3 font-medium">{{n-a zone.name}}</td>
                        <td class="px-4 py-3">{{n-a zone.warehouse.name}}</td>
                        <td class="px-4 py-3">{{n-a zone.type}}</td>
                        <td class="px-4 py-3"><Badge @status={{if (eq zone.status "active") "success" "default"}}>{{n-a zone.status}}</Badge></td>
                        <td class="px-4 py-3 text-right">{{n-a zone.utilization_percentage}}</td>
                    </tr>
                {{else}}
                    <tr><td colspan="5" class="px-4 py-8 text-center text-gray-500">No zones yet.</td></tr>
                {{/each}}
            </tbody>
        </table>
    </ContentPanel>
</Layout::Section::Body>
