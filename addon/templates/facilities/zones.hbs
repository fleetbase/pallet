<Layout::Section::Header @title={{t "facilities.zones.title"}}>
    <div class="text-sm text-gray-500 dark:text-gray-300">Manage general, receiving, shipping, staging, returns, and cold storage zones across warehouses.</div>
</Layout::Section::Header>

<Layout::Section::Body class="overflow-y-scroll h-full p-4">
    <ContentPanel @title={{t "facilities.zones.create"}} @open={{true}} @wrapperClass="bordered-classic mb-4">
        <div class="grid grid-cols-1 gap-3 text-xs lg:grid-cols-6">
            <InputGroup @name={{t "operations.common.warehouse"}}>
                <ModelSelect
                    @modelName="warehouse"
                    @selectedModel={{this.newZone.warehouse}}
                    @placeholder={{t "operations.common.warehouse"}}
                    @triggerClass="form-select form-input"
                    @infiniteScroll={{false}}
                    @renderInPlace={{true}}
                    @onChange={{this.setWarehouse}}
                    as |model|
                >
                    {{n-a model.name model.address}}
                </ModelSelect>
            </InputGroup>

            <InputGroup @name={{t "common.name"}}>
                <Input @value={{this.newZone.name}} class="w-full form-input" placeholder="Receiving" />
            </InputGroup>

            <InputGroup @name={{t "facilities.zones.code"}}>
                <Input @value={{this.newZone.code}} class="w-full form-input" placeholder="RCV" />
            </InputGroup>

            <InputGroup @name={{t "operations.common.type"}}>
                <Select class="w-full form-input form-select" @options={{this.zoneTypes}} @value={{this.newZone.type}} @onSelect={{this.setType}} @humanize={{true}} />
            </InputGroup>

            <InputGroup @name={{t "facilities.zones.capacity"}}>
                <Input @value={{this.newZone.capacity}} @type="number" class="w-full form-input" placeholder="0" />
            </InputGroup>

            <div class="flex items-end">
                <Button @icon="plus" @type="primary" @text={{t "common.create"}} @onClick={{this.createZone}} @wrapperClass="w-full" />
            </div>
        </div>
    </ContentPanel>

    <ContentPanel @title={{t "facilities.zones.list-title"}} @open={{true}} @wrapperClass="bordered-classic" @panelBodyWrapperClass="px-0i py-0i">
        <table class="w-full text-sm">
            <thead>
                <tr class="border-b border-gray-200 dark:border-gray-700 text-left text-xs uppercase text-gray-500">
                    <th class="px-4 py-3">Zone</th>
                    <th class="px-4 py-3">Code</th>
                    <th class="px-4 py-3">Warehouse</th>
                    <th class="px-4 py-3">Type</th>
                    <th class="px-4 py-3">Status</th>
                    <th class="px-4 py-3 text-right">Capacity</th>
                    <th class="px-4 py-3 text-right">Utilization</th>
                </tr>
            </thead>
            <tbody>
                {{#each @model as |zone|}}
                    <tr class="border-b border-gray-100 dark:border-gray-800">
                        <td class="px-4 py-3 font-medium">{{n-a zone.name}}</td>
                        <td class="px-4 py-3">{{n-a zone.code}}</td>
                        <td class="px-4 py-3">{{n-a zone.warehouse.name}}</td>
                        <td class="px-4 py-3">{{smart-humanize (n-a zone.type)}}</td>
                        <td class="px-4 py-3"><Badge @status={{if (eq zone.status "active") "success" "default"}}>{{smart-humanize (n-a zone.status)}}</Badge></td>
                        <td class="px-4 py-3 text-right">{{n-a zone.capacity}}</td>
                        <td class="px-4 py-3 text-right">{{zone.utilization_percentage}}%</td>
                    </tr>
                {{else}}
                    <tr><td colspan="7" class="px-4 py-8 text-center text-gray-500">No zones yet.</td></tr>
                {{/each}}
            </tbody>
        </table>
    </ContentPanel>
</Layout::Section::Body>