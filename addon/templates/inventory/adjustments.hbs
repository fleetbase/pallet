<Layout::Section::Header @title="Stock Adjustments">
    <div class="flex flex-1 items-center justify-between gap-3">
        <div class="text-sm text-gray-500 dark:text-gray-300">Track inventory corrections, discrepancies, and manual quantity changes from a dedicated inventory control surface.</div>
        <Button @icon="plus" @type="primary" @size="sm" @text="New Adjustment" @onClick={{this.createAdjustment}} />
    </div>
</Layout::Section::Header>

<Layout::Section::Body class="overflow-y-scroll h-full p-4">
    <ContentPanel @title="Adjustment History" @open={{true}} @wrapperClass="bordered-classic" @panelBodyWrapperClass="px-0i py-0i">
        <table class="w-full text-sm">
            <thead>
                <tr class="border-b border-gray-200 dark:border-gray-700 text-left text-xs uppercase text-gray-500">
                    <th class="px-4 py-3">Product</th>
                    <th class="px-4 py-3">Variant</th>
                    <th class="px-4 py-3">Type</th>
                    <th class="px-4 py-3">Reason</th>
                    <th class="px-4 py-3 text-right">Before</th>
                    <th class="px-4 py-3 text-right">After</th>
                    <th class="px-4 py-3 text-right">Delta</th>
                    <th class="px-4 py-3">Created</th>
                </tr>
            </thead>
            <tbody>
                {{#each @model as |adjustment|}}
                    <tr class="border-b border-gray-100 dark:border-gray-800">
                        <td class="px-4 py-3 font-medium">{{n-a adjustment.product.name}}</td>
                        <td class="px-4 py-3">{{n-a adjustment.variant.display_name}}</td>
                        <td class="px-4 py-3"><Badge @status="info">{{n-a adjustment.type}}</Badge></td>
                        <td class="px-4 py-3">{{n-a adjustment.reason}}</td>
                        <td class="px-4 py-3 text-right">{{n-a adjustment.before_quantity}}</td>
                        <td class="px-4 py-3 text-right">{{n-a adjustment.after_quantity}}</td>
                        <td class="px-4 py-3 text-right font-semibold">{{n-a adjustment.quantity}}</td>
                        <td class="px-4 py-3">{{n-a adjustment.createdAt}}</td>
                    </tr>
                {{else}}
                    <tr><td colspan="8" class="px-4 py-8 text-center text-gray-500">No stock adjustments yet.</td></tr>
                {{/each}}
            </tbody>
        </table>
    </ContentPanel>
</Layout::Section::Body>
