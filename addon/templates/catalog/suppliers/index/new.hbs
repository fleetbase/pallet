<Layout::Resource::Panel
    @resource={{this.supplier}}
    @controller={{this}}
    @headerTitle="Create a new supplier"
    @saveTask={{this.save}}
    @onPressCancel={{transition-to "catalog.suppliers.index"}}
    @onOverlayReady={{fn (mut this.overlay)}}
>
    <Supplier::Form @resource={{this.supplier}} @controller={{this}} />
    <Spacer @height="200px" />
</Layout::Resource::Panel>