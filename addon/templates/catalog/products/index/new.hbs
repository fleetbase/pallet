<Layout::Resource::Panel
    class="pallet-overlay-fill"
    @resource={{this.product}}
    @controller={{this}}
    @headerTitle="Create a new product"
    @saveTask={{this.save}}
    @onPressCancel={{transition-to "catalog.products.index"}}
    @onOverlayReady={{fn (mut this.overlay)}}
    @width="920px"
>
    <Product::Form @resource={{this.product}} @controller={{this}} />
    <Spacer @height="200px" />
</Layout::Resource::Panel>