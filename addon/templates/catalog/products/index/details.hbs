<Layout::Resource::Panel
    class="pallet-overlay-fill"
    @resource={{@model}}
    @controller={{this}}
    @headerComponent={{component "product/panel-header" resource=@model}}
    @headerTitle={{@model.name}}
    @actionButtons={{this.actionButtons}}
    @onPressCancel={{transition-to "catalog.products.index"}}
    @onOverlayReady={{fn (mut this.overlay)}}
    @headerClass="no-bottom-border"
    @bodyClass="no-scroll"
    @width="760px"
>
    <TabNavigation @tabs={{this.tabs}} @containerClass="tab-navigation-fill" @contentClass="scrollable" @tablistClass="pl-2">
        {{outlet}}
    </TabNavigation>
</Layout::Resource::Panel>