<Layout::Section::Body class="overflow-y-scroll h-full">
    <Dashboard
        @defaultDashboardId="pallet"
        @defaultDashboardName="Pallet Dashboard"
        @extension="pallet"
        @leftHeaderWrapperClass="pallet-dashboard-title"
        @rightHeaderWrapperClass="pallet-dashboard-actions"
        @createWrapperClass="pallet-dashboard-create-wrapper"
        @stickyHeader={{true}}
        class="pallet-dashboard-page"
    />
    <Spacer @height="300px" />
    {{outlet}}
</Layout::Section::Body>