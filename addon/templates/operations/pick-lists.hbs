<Layout::Section::Header @title={{t "operations.pick-lists.title"}}>
    <div class="text-sm text-gray-500 dark:text-gray-300">Execute outbound warehouse work and track picking progress.</div>
</Layout::Section::Header>

<Layout::Section::Body class="overflow-y-scroll h-full p-4">
    <ContentPanel @title={{t "operations.pick-lists.create"}} @open={{true}} @wrapperClass="bordered-classic mb-4">
        <div class="grid grid-cols-1 gap-3 text-xs lg:grid-cols-5">
            <InputGroup @name={{t "operations.common.warehouse"}}>
                <ModelSelect
                    @modelName="warehouse"
                    @selectedModel={{this.newPickList.warehouse}}
                    @placeholder={{t "operations.common.warehouse"}}
                    @triggerClass="form-select form-input"
                    @infiniteScroll={{false}}
                    @renderInPlace={{true}}
                    @onChange={{this.setPickListWarehouse}}
                    as |model|
                >
                    {{n-a model.name model.address}}
                </ModelSelect>
            </InputGroup>

            <InputGroup @name={{t "operations.pick-lists.wave"}}>
                <ModelSelect
                    @modelName="wave"
                    @selectedModel={{this.newPickList.wave}}
                    @placeholder={{t "operations.pick-lists.wave-placeholder"}}
                    @triggerClass="form-select form-input"
                    @infiniteScroll={{false}}
                    @renderInPlace={{true}}
                    @onChange={{this.setPickListWave}}
                    as |model|
                >
                    {{n-a model.wave_number model.public_id}}
                </ModelSelect>
            </InputGroup>

            <InputGroup @name={{t "operations.common.type"}}>
                <Input @value={{this.newPickList.type}} class="w-full form-input" placeholder="discrete" />
            </InputGroup>

            <InputGroup @name={{t "operations.common.priority"}}>
                <Input @value={{this.newPickList.priority}} @type="number" class="w-full form-input" />
            </InputGroup>

            <div class="flex items-end">
                <Button @icon="plus" @type="primary" @text={{t "common.create"}} @onClick={{this.createPickList}} @wrapperClass="w-full" />
            </div>
        </div>
    </ContentPanel>

    <ContentPanel @title={{t "operations.pick-lists.add-pick-item"}} @open={{true}} @wrapperClass="bordered-classic mb-4">
        <div class="grid grid-cols-1 gap-3 text-xs lg:grid-cols-7">
            <InputGroup @name={{t "operations.pick-lists.pick-list"}}>
                <div class="fleetbase-model-select fleetbase-power-select ember-model-select">
                    <PowerSelect
                        @options={{@model}}
                        @selected={{this.newPickItem.pickList}}
                        @onChange={{fn (mut this.newPickItem.pickList)}}
                        @placeholder={{t "operations.pick-lists.pick-list"}}
                        @triggerClass="form-select form-input"
                        as |pickList|
                    >
                        {{n-a pickList.pick_list_number pickList.public_id}}
                    </PowerSelect>
                </div>
            </InputGroup>

            <InputGroup @name={{t "operations.common.product"}}>
                <ModelSelect
                    @modelName="pallet-product"
                    @selectedModel={{this.newPickItem.product}}
                    @placeholder={{t "operations.common.product"}}
                    @triggerClass="form-select form-input"
                    @infiniteScroll={{false}}
                    @renderInPlace={{true}}
                    @onChange={{this.setPickItemProduct}}
                    as |model|
                >
                    {{model.name}}
                </ModelSelect>
            </InputGroup>

            <InputGroup @name={{t "operations.common.variant"}}>
                <div class="fleetbase-model-select fleetbase-power-select ember-model-select">
                    <PowerSelect
                        @options={{this.newPickItem.product.variants}}
                        @selected={{this.newPickItem.variant}}
                        @onChange={{this.setPickItemVariant}}
                        @placeholder={{t "operations.common.variant"}}
                        @triggerClass="form-select form-input"
                        @disabled={{not this.newPickItem.product.has_variants}}
                        as |variant|
                    >
                        {{n-a variant.display_name variant.name}}
                    </PowerSelect>
                </div>
            </InputGroup>

            <InputGroup @name={{t "operations.pick-lists.inventory"}}>
                <ModelSelect
                    @modelName="inventory"
                    @selectedModel={{this.newPickItem.inventory}}
                    @placeholder={{t "operations.pick-lists.inventory-placeholder"}}
                    @triggerClass="form-select form-input"
                    @infiniteScroll={{false}}
                    @renderInPlace={{true}}
                    @onChange={{this.setPickItemInventory}}
                    as |model|
                >
                    {{n-a model.lot_number model.serial_number model.public_id}}
                </ModelSelect>
            </InputGroup>

            <InputGroup @name={{t "operations.pick-lists.bin"}}>
                <ModelSelect
                    @modelName="bin-location"
                    @selectedModel={{this.newPickItem.binLocation}}
                    @placeholder={{t "operations.pick-lists.bin-placeholder"}}
                    @triggerClass="form-select form-input"
                    @infiniteScroll={{false}}
                    @renderInPlace={{true}}
                    @onChange={{this.setPickItemBinLocation}}
                    as |model|
                >
                    {{n-a model.bin_number model.barcode model.public_id}}
                </ModelSelect>
            </InputGroup>

            <InputGroup @name={{t "operations.common.quantity"}}>
                <Input @value={{this.newPickItem.quantity_requested}} @type="number" class="w-full form-input" placeholder="Qty" />
            </InputGroup>

            <div class="flex items-end">
                <Button @icon="plus" @type="primary" @text={{t "operations.pick-lists.add-item"}} @onClick={{this.createPickListItem}} @wrapperClass="w-full" />
            </div>
        </div>
    </ContentPanel>

    <ContentPanel @title={{t "operations.pick-lists.title"}} @open={{true}} @wrapperClass="bordered-classic" @panelBodyWrapperClass="px-0i py-0i">
        <table class="w-full text-sm">
            <thead>
                <tr class="border-b border-gray-200 dark:border-gray-700 text-left text-xs uppercase text-gray-500">
                    <th class="px-4 py-3">Pick List</th>
                    <th class="px-4 py-3">Warehouse</th>
                    <th class="px-4 py-3">Wave</th>
                    <th class="px-4 py-3">Assigned To</th>
                    <th class="px-4 py-3">Type</th>
                    <th class="px-4 py-3">Status</th>
                    <th class="px-4 py-3 text-right">Progress</th>
                    <th class="px-4 py-3 text-right">Actions</th>
                </tr>
            </thead>
            <tbody>
                {{#each @model as |pickList|}}
                    <tr class="border-b border-gray-100 dark:border-gray-800">
                        <td class="px-4 py-3 font-medium">{{n-a pickList.pick_list_number}}</td>
                        <td class="px-4 py-3">{{n-a pickList.warehouse.name}}</td>
                        <td class="px-4 py-3">{{n-a pickList.wave.wave_number pickList.wave.public_id}}</td>
                        <td class="px-4 py-3">{{n-a pickList.assignedTo.name pickList.assignedTo.email}}</td>
                        <td class="px-4 py-3">{{n-a pickList.type}}</td>
                        <td class="px-4 py-3"><Badge @status="info">{{n-a pickList.status}}</Badge></td>
                        <td class="px-4 py-3 text-right">{{n-a pickList.completion_percentage}}</td>
                        <td class="px-4 py-3">
                            <div class="flex items-center justify-end gap-2">
                                {{#if (eq pickList.status "pending")}}
                                    <Button @icon="user-check" @type="default" @size="xs" @text={{t "operations.pick-lists.assign-to-me"}} @onClick={{fn this.assignPickList pickList}} />
                                    <Button @icon="play" @type="primary" @size="xs" @text={{t "operations.common.start"}} @onClick={{fn this.startPickList pickList}} />
                                {{else if (eq pickList.status "assigned")}}
                                    <Button @icon="play" @type="primary" @size="xs" @text={{t "operations.common.start"}} @onClick={{fn this.startPickList pickList}} />
                                {{else if (eq pickList.status "in_progress")}}
                                    <Button @icon="check" @type="success" @size="xs" @text={{t "operations.common.complete"}} @onClick={{fn this.completePickList pickList}} />
                                {{else}}
                                    <span class="text-xs text-gray-400">No actions</span>
                                {{/if}}
                            </div>
                        </td>
                    </tr>
                    {{#if pickList.items.length}}
                        <tr class="border-b border-gray-100 bg-gray-50/60 dark:border-gray-800 dark:bg-gray-900/40">
                            <td colspan="8" class="px-4 py-3">
                                <div class="overflow-x-auto">
                                    <table class="w-full min-w-max text-xs">
                                        <thead>
                                            <tr class="text-left uppercase text-gray-400">
                                                <th class="py-2 pr-3">Item</th>
                                                <th class="py-2 px-3">Location</th>
                                                <th class="py-2 px-3 text-right">Requested</th>
                                                <th class="py-2 px-3 text-right">Picked</th>
                                                <th class="py-2 px-3">Status</th>
                                                <th class="py-2 pl-3 text-right">Action</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            {{#each pickList.items as |item|}}
                                                <tr class="border-t border-gray-100 dark:border-gray-800">
                                                    <td class="py-2 pr-3">
                                                        <div class="font-semibold text-gray-700 dark:text-gray-200">{{n-a item.product.name}}</div>
                                                        <div class="text-gray-400">{{n-a item.variant.display_name item.variant.name item.product.sku}}</div>
                                                    </td>
                                                    <td class="py-2 px-3">{{n-a item.binLocation.name item.binLocation.bin_number item.lot_number item.serial_number}}</td>
                                                    <td class="py-2 px-3 text-right">{{n-a item.quantity_requested}}</td>
                                                    <td class="py-2 px-3 text-right">
                                                        <Input @type="number" @value={{item.quantity_picked}} class="form-input w-20 text-right text-xs" />
                                                    </td>
                                                    <td class="py-2 px-3"><Badge @status={{if (eq item.status "picked") "success" "info"}}>{{n-a item.status}}</Badge></td>
                                                    <td class="py-2 pl-3 text-right">
                                                        {{#if (eq item.status "picked")}}
                                                            <span class="text-xs text-gray-400">Picked</span>
                                                        {{else}}
                                                            <Button @icon="check" @type="success" @size="xs" @text={{t "operations.pick-lists.picked"}} @onClick={{fn this.markPickListItemPicked item}} />
                                                        {{/if}}
                                                    </td>
                                                </tr>
                                            {{/each}}
                                        </tbody>
                                    </table>
                                </div>
                            </td>
                        </tr>
                    {{/if}}
                {{else}}
                    <tr><td colspan="8" class="px-4 py-8 text-center text-gray-500">No pick lists yet.</td></tr>
                {{/each}}
            </tbody>
        </table>
    </ContentPanel>
</Layout::Section::Body>
