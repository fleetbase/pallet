<Layout::Section::Header @title={{t "operations.transfers.title"}}>
    <div class="text-sm text-gray-500 dark:text-gray-300">{{t "operations.transfers.description"}}</div>
</Layout::Section::Header>

<Layout::Section::Body class="overflow-y-scroll h-full p-4">
    <ContentPanel @title={{t "operations.transfers.create"}} @open={{true}} @wrapperClass="bordered-classic mb-4">
        <div class="grid grid-cols-1 gap-3 text-xs lg:grid-cols-6">
            <InputGroup @name={{t "operations.transfers.from-warehouse"}}>
                <ModelSelect
                    @modelName="warehouse"
                    @selectedModel={{this.newTransfer.fromWarehouse}}
                    @placeholder={{t "operations.transfers.source-placeholder"}}
                    @triggerClass="form-select form-input"
                    @infiniteScroll={{false}}
                    @renderInPlace={{true}}
                    @onChange={{this.setFromWarehouse}}
                    as |model|
                >
                    {{n-a model.name model.address}}
                </ModelSelect>
            </InputGroup>

            <InputGroup @name={{t "operations.transfers.to-warehouse"}}>
                <ModelSelect
                    @modelName="warehouse"
                    @selectedModel={{this.newTransfer.toWarehouse}}
                    @placeholder={{t "operations.transfers.destination-placeholder"}}
                    @triggerClass="form-select form-input"
                    @infiniteScroll={{false}}
                    @renderInPlace={{true}}
                    @onChange={{this.setToWarehouse}}
                    as |model|
                >
                    {{n-a model.name model.address}}
                </ModelSelect>
            </InputGroup>

            <InputGroup @name={{t "operations.common.product"}}>
                <ModelSelect
                    @modelName="pallet-product"
                    @selectedModel={{this.newTransfer.product}}
                    @placeholder={{t "operations.common.product"}}
                    @triggerClass="form-select form-input"
                    @infiniteScroll={{false}}
                    @renderInPlace={{true}}
                    @onChange={{this.setTransferProduct}}
                    as |model|
                >
                    {{model.name}}
                </ModelSelect>
            </InputGroup>

            <InputGroup @name={{t "operations.common.variant"}}>
                <div class="fleetbase-model-select fleetbase-power-select ember-model-select">
                    <PowerSelect
                        @options={{this.newTransfer.product.variants}}
                        @selected={{this.newTransfer.variant}}
                        @onChange={{this.setTransferVariant}}
                        @placeholder={{t "operations.common.variant"}}
                        @triggerClass="form-select form-input"
                        @disabled={{not this.newTransfer.product.has_variants}}
                        as |variant|
                    >
                        {{n-a variant.display_name variant.name}}
                    </PowerSelect>
                </div>
            </InputGroup>

            <InputGroup @name={{t "operations.common.quantity"}}>
                <Input @value={{this.newTransfer.quantity}} @type="number" class="w-full form-input" placeholder="Qty" />
            </InputGroup>

            <div class="flex items-end">
                <Button @icon="plus" @type="primary" @text={{t "common.create"}} @onClick={{this.createTransfer}} @wrapperClass="w-full" />
            </div>
        </div>
    </ContentPanel>

    <ContentPanel @title={{t "operations.transfers.list-title"}} @open={{true}} @wrapperClass="bordered-classic" @panelBodyWrapperClass="px-0i py-0i">
        <table class="w-full text-sm">
            <thead>
                <tr class="border-b border-gray-200 dark:border-gray-700 text-left text-xs uppercase text-gray-500">
                    <th class="px-4 py-3">Transfer</th>
                    <th class="px-4 py-3">From</th>
                    <th class="px-4 py-3">To</th>
                    <th class="px-4 py-3">Items</th>
                    <th class="px-4 py-3">Status</th>
                    <th class="px-4 py-3 text-right">Quantity</th>
                    <th class="px-4 py-3 text-right">Actions</th>
                </tr>
            </thead>
            <tbody>
                {{#each @model as |transfer|}}
                    <tr class="border-b border-gray-100 dark:border-gray-800">
                        <td class="px-4 py-3 font-medium">{{n-a transfer.transfer_number}}</td>
                        <td class="px-4 py-3">{{n-a transfer.fromWarehouse.name}}</td>
                        <td class="px-4 py-3">{{n-a transfer.toWarehouse.name}}</td>
                        <td class="px-4 py-3">
                            <div class="flex max-w-xs flex-col gap-1">
                                {{#each transfer.items as |item|}}
                                    <div class="truncate text-xs text-gray-600 dark:text-gray-300">
                                        {{n-a item.product.name}} {{#if item.variant}}· {{n-a item.variant.display_name item.variant.name}}{{/if}}
                                    </div>
                                {{else}}
                                    <span class="text-xs text-gray-400">No items</span>
                                {{/each}}
                            </div>
                        </td>
                        <td class="px-4 py-3"><Badge @status="info">{{n-a transfer.status}}</Badge></td>
                        <td class="px-4 py-3 text-right">{{n-a transfer.total_quantity}}</td>
                        <td class="px-4 py-3">
                            <div class="flex items-center justify-end gap-2">
                                {{#if (eq transfer.status "pending")}}
                                    <Button @icon="thumbs-up" @type="primary" @size="xs" @text={{t "operations.common.approve"}} @onClick={{fn this.approveTransfer transfer}} />
                                    <Button @icon="ban" @type="danger" @size="xs" @text={{t "common.cancel"}} @onClick={{fn this.cancelTransfer transfer}} />
                                {{else if (eq transfer.status "approved")}}
                                    <Button @icon="truck" @type="primary" @size="xs" @text={{t "operations.transfers.ship"}} @onClick={{fn this.shipTransfer transfer}} />
                                    <Button @icon="ban" @type="danger" @size="xs" @text={{t "common.cancel"}} @onClick={{fn this.cancelTransfer transfer}} />
                                {{else if (eq transfer.status "in_transit")}}
                                    <Button @icon="box-open" @type="success" @size="xs" @text={{t "operations.transfers.receive"}} @onClick={{fn this.receiveTransfer transfer}} />
                                {{else}}
                                    <span class="text-xs text-gray-400">No actions</span>
                                {{/if}}
                            </div>
                        </td>
                    </tr>
                {{else}}
                    <tr><td colspan="7" class="px-4 py-8 text-center text-gray-500">No transfers yet.</td></tr>
                {{/each}}
            </tbody>
        </table>
    </ContentPanel>
</Layout::Section::Body>
