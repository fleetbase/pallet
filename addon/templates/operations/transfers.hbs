<Layout::Section::Header @title="Transfers">
    <div class="text-sm text-gray-500 dark:text-gray-300">Track stock movement between warehouses from request through receipt.</div>
</Layout::Section::Header>

<Layout::Section::Body class="overflow-y-scroll h-full p-4">
    <ContentPanel @title="Stock Transfers" @open={{true}} @wrapperClass="bordered-classic" @panelBodyWrapperClass="px-0i py-0i">
        <table class="w-full text-sm">
            <thead>
                <tr class="border-b border-gray-200 dark:border-gray-700 text-left text-xs uppercase text-gray-500">
                    <th class="px-4 py-3">Transfer</th>
                    <th class="px-4 py-3">From</th>
                    <th class="px-4 py-3">To</th>
                    <th class="px-4 py-3">Status</th>
                    <th class="px-4 py-3 text-right">Quantity</th>
                    <th class="px-4 py-3 text-right">Actions</th>
                </tr>
            </thead>
            <tbody>
                {{#each @model as |transfer|}}
                    <tr class="border-b border-gray-100 dark:border-gray-800">
                        <td class="px-4 py-3 font-medium">{{n-a transfer.transfer_number}}</td>
                        <td class="px-4 py-3">{{n-a transfer.fromWarehouse.name}}</td>
                        <td class="px-4 py-3">{{n-a transfer.toWarehouse.name}}</td>
                        <td class="px-4 py-3"><Badge @status="info">{{n-a transfer.status}}</Badge></td>
                        <td class="px-4 py-3 text-right">{{n-a transfer.total_quantity}}</td>
                        <td class="px-4 py-3">
                            <div class="flex items-center justify-end gap-2">
                                {{#if (eq transfer.status "pending")}}
                                    <Button @icon="thumbs-up" @type="primary" @size="xs" @text="Approve" @onClick={{fn this.approveTransfer transfer}} />
                                    <Button @icon="ban" @type="danger" @size="xs" @text="Cancel" @onClick={{fn this.cancelTransfer transfer}} />
                                {{else if (eq transfer.status "approved")}}
                                    <Button @icon="truck" @type="primary" @size="xs" @text="Ship" @onClick={{fn this.shipTransfer transfer}} />
                                    <Button @icon="ban" @type="danger" @size="xs" @text="Cancel" @onClick={{fn this.cancelTransfer transfer}} />
                                {{else if (eq transfer.status "in_transit")}}
                                    <Button @icon="box-open" @type="success" @size="xs" @text="Receive" @onClick={{fn this.receiveTransfer transfer}} />
                                {{else}}
                                    <span class="text-xs text-gray-400">No actions</span>
                                {{/if}}
                            </div>
                        </td>
                    </tr>
                {{else}}
                    <tr><td colspan="6" class="px-4 py-8 text-center text-gray-500">No transfers yet.</td></tr>
                {{/each}}
            </tbody>
        </table>
    </ContentPanel>
</Layout::Section::Body>
