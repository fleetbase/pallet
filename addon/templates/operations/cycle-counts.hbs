<Layout::Section::Header @title="Cycle Counts">
    <div class="text-sm text-gray-500 dark:text-gray-300">Schedule and reconcile recurring inventory counts by warehouse or zone.</div>
</Layout::Section::Header>

<Layout::Section::Body class="overflow-y-scroll h-full p-4">
    <ContentPanel @title="Cycle Counts" @open={{true}} @wrapperClass="bordered-classic" @panelBodyWrapperClass="px-0i py-0i">
        <table class="w-full text-sm">
            <thead>
                <tr class="border-b border-gray-200 dark:border-gray-700 text-left text-xs uppercase text-gray-500">
                    <th class="px-4 py-3">Count</th>
                    <th class="px-4 py-3">Warehouse</th>
                    <th class="px-4 py-3">Zone</th>
                    <th class="px-4 py-3">Status</th>
                    <th class="px-4 py-3 text-right">Accuracy</th>
                    <th class="px-4 py-3 text-right">Actions</th>
                </tr>
            </thead>
            <tbody>
                {{#each @model as |count|}}
                    <tr class="border-b border-gray-100 dark:border-gray-800">
                        <td class="px-4 py-3 font-medium">{{n-a count.count_number}}</td>
                        <td class="px-4 py-3">{{n-a count.warehouse.name}}</td>
                        <td class="px-4 py-3">{{n-a count.zone.name}}</td>
                        <td class="px-4 py-3"><Badge @status="info">{{n-a count.status}}</Badge></td>
                        <td class="px-4 py-3 text-right">{{n-a count.accuracy_percentage}}</td>
                        <td class="px-4 py-3">
                            <div class="flex items-center justify-end gap-2">
                                {{#if (eq count.status "pending")}}
                                    <Button @icon="play" @type="primary" @size="xs" @text="Start" @onClick={{fn this.startCycleCount count}} />
                                {{else if (eq count.status "in_progress")}}
                                    <Button @icon="check" @type="success" @size="xs" @text="Complete" @onClick={{fn this.completeCycleCount count}} />
                                {{else if (eq count.status "completed")}}
                                    <Button @icon="thumbs-up" @type="primary" @size="xs" @text="Approve" @onClick={{fn this.approveCycleCount count}} />
                                {{else}}
                                    <span class="text-xs text-gray-400">No actions</span>
                                {{/if}}
                            </div>
                        </td>
                    </tr>
                {{else}}
                    <tr><td colspan="6" class="px-4 py-8 text-center text-gray-500">No cycle counts yet.</td></tr>
                {{/each}}
            </tbody>
        </table>
    </ContentPanel>
</Layout::Section::Body>
