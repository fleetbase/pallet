<Layout::Section::Header @title={{t "operations.reservations.title"}}>
    <div class="text-sm text-gray-500 dark:text-gray-300">View committed stock before fulfillment execution.</div>
</Layout::Section::Header>

<Layout::Section::Body class="overflow-y-scroll h-full p-4">
    <ContentPanel @title={{t "operations.reservations.create"}} @open={{true}} @wrapperClass="bordered-classic mb-4">
        <div class="grid grid-cols-1 gap-3 text-xs lg:grid-cols-6">
            <InputGroup @name={{t "operations.common.product"}}>
                <ModelSelect
                    @modelName="pallet-product"
                    @selectedModel={{this.newReservation.product}}
                    @placeholder={{t "operations.common.product"}}
                    @triggerClass="form-select form-input"
                    @infiniteScroll={{false}}
                    @renderInPlace={{true}}
                    @onChange={{this.setReservationProduct}}
                    as |model|
                >
                    {{model.name}}
                </ModelSelect>
            </InputGroup>

            <InputGroup @name={{t "operations.common.variant"}}>
                <div class="fleetbase-model-select fleetbase-power-select ember-model-select">
                    <PowerSelect
                        @options={{this.newReservation.product.variants}}
                        @selected={{this.newReservation.variant}}
                        @onChange={{this.setReservationVariant}}
                        @placeholder={{t "operations.common.variant"}}
                        @triggerClass="form-select form-input"
                        @disabled={{not this.newReservation.product.has_variants}}
                        as |variant|
                    >
                        {{n-a (or variant.display_name variant.name)}}
                    </PowerSelect>
                </div>
            </InputGroup>

            <InputGroup @name={{t "operations.common.warehouse"}}>
                <ModelSelect
                    @modelName="warehouse"
                    @selectedModel={{this.newReservation.warehouse}}
                    @placeholder={{t "operations.common.warehouse"}}
                    @triggerClass="form-select form-input"
                    @infiniteScroll={{false}}
                    @renderInPlace={{true}}
                    @onChange={{this.setReservationWarehouse}}
                    as |model|
                >
                    {{n-a (or model.name model.address)}}
                </ModelSelect>
            </InputGroup>

            <InputGroup @name={{t "operations.common.quantity"}}>
                <Input @value={{this.newReservation.quantity}} @type="number" class="w-full form-input" placeholder="Qty" />
            </InputGroup>

            <InputGroup @name={{t "operations.reservations.expires"}}>
                <Input @value={{this.newReservation.expires_at}} @type="datetime-local" class="w-full form-input" />
            </InputGroup>

            <div class="flex items-end">
                <Button @icon="plus" @type="primary" @text={{t "operations.reservations.reserve"}} @onClick={{this.createReservation}} @wrapperClass="w-full" />
            </div>
        </div>
    </ContentPanel>

    <ContentPanel @title={{t "operations.reservations.context-title"}} @open={{true}} @wrapperClass="bordered-classic mb-4">
        <div class="grid grid-cols-1 gap-3 text-xs lg:grid-cols-6">
            <InputGroup @name={{t "operations.reservations.checkout"}}>
                <Input @value={{this.storefrontContext.storefront_checkout_uuid}} @type="text" class="w-full form-input" placeholder="Checkout UUID" />
            </InputGroup>
            <InputGroup @name={{t "operations.reservations.cart"}}>
                <Input @value={{this.storefrontContext.storefront_cart_uuid}} @type="text" class="w-full form-input" placeholder="Cart UUID" />
            </InputGroup>
            <InputGroup @name={{t "operations.reservations.order"}}>
                <Input @value={{this.storefrontContext.storefront_order_uuid}} @type="text" class="w-full form-input" placeholder="Order UUID" />
            </InputGroup>
            <InputGroup @name={{t "operations.reservations.line"}}>
                <Input @value={{this.storefrontContext.storefront_line_uuid}} @type="text" class="w-full form-input" placeholder="Line UUID" />
            </InputGroup>
            <InputGroup @name={{t "operations.reservations.reservation-key"}}>
                <Input @value={{this.storefrontContext.storefront_reservation_key}} @type="text" class="w-full form-input" placeholder="Key" />
            </InputGroup>
            <div class="flex flex-wrap items-end gap-2">
                <Button @icon="search" @type="default" @text={{t "operations.reservations.lookup"}} @onClick={{this.lookupStorefrontContext}} @wrapperClass="flex-1" />
                <Button @icon="unlock" @type="default" @text={{t "operations.reservations.release"}} @onClick={{this.releaseStorefrontContext}} @wrapperClass="flex-1" />
                <Button @icon="check" @type="primary" @text={{t "operations.reservations.fulfill"}} @onClick={{this.fulfillStorefrontContext}} @wrapperClass="flex-1" />
            </div>
        </div>
    </ContentPanel>

    <ContentPanel @title={{t "operations.reservations.list-title"}} @open={{true}} @wrapperClass="bordered-classic" @panelBodyWrapperClass="px-0i py-0i">
        {{#if this.hasContextReservations}}
            <div class="flex items-center justify-between border-b border-gray-100 px-4 py-2 text-xs dark:border-gray-800">
                <span class="font-semibold text-gray-600 dark:text-gray-300">Showing Storefront context results</span>
                <Button @icon="times" @type="default" @size="xs" @text={{t "operations.reservations.clear"}} @onClick={{this.clearStorefrontContextResults}} />
            </div>
        {{/if}}
        <div class="overflow-x-auto">
        <table class="w-full min-w-max text-sm">
            <thead>
                <tr class="border-b border-gray-200 dark:border-gray-700 text-left text-xs uppercase text-gray-500">
                    <th class="px-4 py-3">Product</th>
                    <th class="px-4 py-3">Variant</th>
                    <th class="px-4 py-3">Warehouse</th>
                    <th class="px-4 py-3">Storefront Context</th>
                    <th class="px-4 py-3">Status</th>
                    <th class="px-4 py-3 text-right">Quantity</th>
                    <th class="px-4 py-3 text-right">Actions</th>
                </tr>
            </thead>
            <tbody>
                {{#each this.reservations as |reservation|}}
                    <tr class="border-b border-gray-100 dark:border-gray-800">
                        <td class="px-4 py-3 font-medium">{{n-a reservation.product.name}}</td>
                        <td class="px-4 py-3">{{n-a reservation.variant.display_name}}</td>
                        <td class="px-4 py-3">{{n-a reservation.warehouse.name}}</td>
                        <td class="px-4 py-3 text-xs text-gray-500 dark:text-gray-400">
                            <div class="space-y-1">
                                <div>Checkout: {{n-a reservation.storefront_checkout_uuid}}</div>
                                <div>Cart: {{n-a reservation.storefront_cart_uuid}}</div>
                                <div>Line: {{n-a reservation.storefront_line_uuid}}</div>
                                <div>Key: {{n-a reservation.storefront_reservation_key}}</div>
                            </div>
                        </td>
                        <td class="px-4 py-3"><Badge @status={{if reservation.is_active "success" "default"}}>{{n-a reservation.status}}</Badge></td>
                        <td class="px-4 py-3 text-right">{{n-a reservation.quantity}}</td>
                        <td class="px-4 py-3">
                            <div class="flex items-center justify-end gap-2">
                                {{#if reservation.is_active}}
                                    <Button @icon="unlock" @type="default" @size="xs" @text={{t "operations.reservations.release"}} @onClick={{fn this.releaseReservation reservation}} />
                                    <Button @icon="check" @type="primary" @size="xs" @text={{t "operations.reservations.fulfill"}} @onClick={{fn this.fulfillReservation reservation}} />
                                {{else}}
                                    <span class="text-xs text-gray-400">No actions</span>
                                {{/if}}
                            </div>
                        </td>
                    </tr>
                {{else}}
                    <tr><td colspan="7" class="px-4 py-8 text-center text-gray-500">No reservations yet.</td></tr>
                {{/each}}
            </tbody>
        </table>
        </div>
    </ContentPanel>
</Layout::Section::Body>
