{{!
    Was three stacked ContentPanels — create a pick list, add a pick item, then a
    raw <table> — with the items table rendered open under every row at once, so
    a handful of pick lists filled several screens and the list could not be
    scanned at all.

    The pick sheet is the working surface, where picked quantities are entered, so
    like cycle counts this drives Table directly for @canExpand;
    Layout::Resource::Tabular cannot host it because its only block replaces the
    Table. Both forms are overlays: creating a list behind New, adding an item
    behind its own header action, since they are different tasks.
}}
<Layout::Section::Header @title={{t "operations.pick-lists.title"}} @searchQuery={{this.query}} @onSearch={{perform this.search}}>
    <Button @icon="plus" @type="default" @text={{t "operations.pick-lists.add-item"}} @onClick={{this.startAddingPickItem}} @wrapperClass="mr-2" />
    <Button @icon="plus" @type="primary" @text={{t "common.new"}} @onClick={{this.startCreatingPickList}} />
</Layout::Section::Header>

<Layout::Section::Body>
    <Table
        @rows={{@model}}
        @columns={{this.columns}}
        @canExpand={{true}}
        @selectable={{false}}
        @pagination={{true}}
        @paginationMeta={{@model.meta}}
        @page={{this.page}}
        @onPageChange={{fn (mut this.page)}}
        as |Table|
    >
        <Table.head />
        <Table.body as |body|>
            <body.expanded-row as |pickList|>
                {{#if pickList.items.length}}
                    <table class="sub-table w-full text-xs dark:text-gray-100">
                        <thead>
                            <tr class="text-left uppercase text-gray-400">
                                <th class="w-1/3 py-2 pr-3">{{t "operations.pick-lists.columns.item"}}</th>
                                <th class="px-3 py-2">{{t "operations.common.location"}}</th>
                                <th class="px-3 py-2 text-right">{{t "operations.pick-lists.columns.requested"}}</th>
                                <th class="px-3 py-2 text-right">{{t "operations.pick-lists.columns.picked"}}</th>
                                <th class="px-3 py-2">{{t "common.status"}}</th>
                                <th class="py-2 pl-3 text-right">{{t "common.actions"}}</th>
                            </tr>
                        </thead>
                        <tbody>
                            {{#each pickList.items as |item|}}
                                <tr class="border-t border-gray-100 dark:border-gray-800">
                                    <td class="py-2 pr-3">
                                        <div class="truncate font-semibold text-gray-700 dark:text-gray-200">{{n-a item.product.name}}</div>
                                        <div class="truncate text-gray-400">{{n-a (or item.variant.display_name item.variant.name item.product.sku)}}</div>
                                    </td>
                                    <td class="truncate px-3 py-2">{{n-a (or item.binLocation.bin_number item.lot_number item.serial_number)}}</td>
                                    <td class="px-3 py-2 text-right tabular-nums">{{n-a item.quantity_requested}}</td>
                                    <td class="px-3 py-2 text-right">
                                        <Input @type="number" @value={{item.quantity_picked}} class="form-input w-20 text-right text-xs" disabled={{eq item.status "picked"}} />
                                    </td>
                                    <td class="px-3 py-2"><Badge @status={{if (eq item.status "picked") "success" "info"}}>{{n-a item.status}}</Badge></td>
                                    <td class="py-2 pl-3 text-right">
                                        {{#unless (eq item.status "picked")}}
                                            <Button @icon="check" @type="success" @size="xs" @text={{t "operations.pick-lists.picked"}} @onClick={{fn this.markPickListItemPicked item}} />
                                        {{/unless}}
                                    </td>
                                </tr>
                            {{/each}}
                        </tbody>
                    </table>
                {{else}}
                    <div class="py-3 text-xs text-gray-400">{{t "operations.pick-lists.no-items"}}</div>
                {{/if}}
            </body.expanded-row>
        </Table.body>
    </Table>
</Layout::Section::Body>

{{#if this.isCreatingPickList}}
    <Overlay @position="right" @noBackdrop={{true}} @fullHeight={{true}} @isResizable={{true}} @width="720px">
        <Overlay::Header @title={{t "operations.pick-lists.create"}} @hideStatusDot={{true}}>
            <:actions>
                <Button @icon="check" @type="primary" @text={{t "common.create"}} @onClick={{this.createPickList}} @wrapperClass="mr-2" />
                <Button @type="default" @icon="times" @helpText={{t "common.cancel"}} @onClick={{this.cancelCreatingPickList}} />
            </:actions>
        </Overlay::Header>

        <Overlay::Body @wrapperClass="px-4 pt-4" @increaseInnerBodyHeightBy={{700}}>
            <div class="grid grid-cols-1 gap-2 text-xs lg:grid-cols-2 no-input-group-padding">
                <InputGroup @name={{t "operations.common.warehouse"}}>
                    <ModelSelect
                        @modelName="warehouse"
                        @selectedModel={{this.newPickList.warehouse}}
                        @placeholder={{t "operations.common.warehouse"}}
                        @triggerClass="form-select form-input"
                        @infiniteScroll={{false}}
                        @renderInPlace={{true}}
                        @onChange={{this.setPickListWarehouse}}
                        as |model|
                    >
                        {{n-a (or model.name model.address)}}
                    </ModelSelect>
                </InputGroup>

                <InputGroup @name={{t "operations.pick-lists.wave"}}>
                    <ModelSelect
                        @modelName="wave"
                        @selectedModel={{this.newPickList.wave}}
                        @placeholder={{t "operations.pick-lists.wave-placeholder"}}
                        @triggerClass="form-select form-input"
                        @infiniteScroll={{false}}
                        @renderInPlace={{true}}
                        @onChange={{this.setPickListWave}}
                        as |model|
                    >
                        {{n-a (or model.wave_number model.public_id)}}
                    </ModelSelect>
                </InputGroup>

                {{!
                            Wave::release() only allocates pick lists that carry a sales_order_uuid,
                            so without this field every pick list created here was invisible to a
                            wave: releasing allocated nothing and reserved nothing.
                        }}
                <InputGroup @name={{t "operations.pick-lists.sales-order"}}>
                    <ModelSelect
                        @modelName="sales-order"
                        @selectedModel={{this.newPickList.salesOrder}}
                        @placeholder={{t "operations.pick-lists.sales-order-placeholder"}}
                        @triggerClass="form-select form-input"
                        @infiniteScroll={{false}}
                        @renderInPlace={{true}}
                        @onChange={{this.setPickListSalesOrder}}
                        as |model|
                    >
                        {{n-a (or model.order_number model.public_id)}}
                    </ModelSelect>
                </InputGroup>

                <InputGroup @name={{t "operations.common.type"}}>
                    <Select class="w-full form-input form-select" @options={{this.pickListTypes}} @value={{this.newPickList.type}} @onSelect={{this.setType}} @humanize={{true}} />
                </InputGroup>

                <InputGroup @name={{t "operations.common.priority"}}>
                    <Input @value={{this.newPickList.priority}} @type="number" class="w-full form-input" />
                </InputGroup>

            </div>
        </Overlay::Body>
    </Overlay>
{{/if}}

{{#if this.isAddingPickItem}}
    <Overlay @position="right" @noBackdrop={{true}} @fullHeight={{true}} @isResizable={{true}} @width="720px">
        <Overlay::Header @title={{t "operations.pick-lists.add-pick-item"}} @hideStatusDot={{true}}>
            <:actions>
                <Button @icon="check" @type="primary" @text={{t "operations.pick-lists.add-item"}} @onClick={{this.createPickListItem}} @wrapperClass="mr-2" />
                <Button @type="default" @icon="times" @helpText={{t "common.cancel"}} @onClick={{this.cancelAddingPickItem}} />
            </:actions>
        </Overlay::Header>

        <Overlay::Body @wrapperClass="px-4 pt-4" @increaseInnerBodyHeightBy={{700}}>
            <div class="grid grid-cols-1 gap-2 text-xs lg:grid-cols-2 no-input-group-padding">
                <InputGroup @name={{t "operations.pick-lists.pick-list"}}>
                    <div class="fleetbase-model-select fleetbase-power-select ember-model-select">
                        <PowerSelect
                            @options={{@model}}
                            @selected={{this.newPickItem.pickList}}
                            @onChange={{fn (mut this.newPickItem.pickList)}}
                            @placeholder={{t "operations.pick-lists.pick-list"}}
                            @triggerClass="form-select form-input"
                            as |pickList|
                        >
                            {{n-a (or pickList.pick_list_number pickList.public_id)}}
                        </PowerSelect>
                    </div>
                </InputGroup>

                <InputGroup @name={{t "operations.common.product"}}>
                    <ModelSelect
                        @modelName="pallet-product"
                        @selectedModel={{this.newPickItem.product}}
                        @placeholder={{t "operations.common.product"}}
                        @triggerClass="form-select form-input"
                        @infiniteScroll={{false}}
                        @renderInPlace={{true}}
                        @onChange={{this.setPickItemProduct}}
                        as |model|
                    >
                        {{model.name}}
                    </ModelSelect>
                </InputGroup>

                <InputGroup @name={{t "operations.common.variant"}}>
                    <div class="fleetbase-model-select fleetbase-power-select ember-model-select">
                        <PowerSelect
                            @options={{this.newPickItem.product.variants}}
                            @selected={{this.newPickItem.variant}}
                            @onChange={{this.setPickItemVariant}}
                            @placeholder={{t "operations.common.variant"}}
                            @triggerClass="form-select form-input"
                            @disabled={{not this.newPickItem.product.has_variants}}
                            as |variant|
                        >
                            {{n-a (or variant.display_name variant.name)}}
                        </PowerSelect>
                    </div>
                </InputGroup>

                <InputGroup @name={{t "operations.pick-lists.inventory"}}>
                    <ModelSelect
                        @modelName="inventory"
                        @selectedModel={{this.newPickItem.inventory}}
                        @placeholder={{t "operations.pick-lists.inventory-placeholder"}}
                        @triggerClass="form-select form-input"
                        @infiniteScroll={{false}}
                        @renderInPlace={{true}}
                        @onChange={{this.setPickItemInventory}}
                        as |model|
                    >
                        {{n-a model.lot_number model.serial_number model.public_id}}
                    </ModelSelect>
                </InputGroup>

                <InputGroup @name={{t "operations.pick-lists.bin"}}>
                    <ModelSelect
                        @modelName="bin-location"
                        @selectedModel={{this.newPickItem.binLocation}}
                        @placeholder={{t "operations.pick-lists.bin-placeholder"}}
                        @triggerClass="form-select form-input"
                        @infiniteScroll={{false}}
                        @renderInPlace={{true}}
                        @onChange={{this.setPickItemBinLocation}}
                        as |model|
                    >
                        {{n-a model.bin_number model.barcode model.public_id}}
                    </ModelSelect>
                </InputGroup>

                <InputGroup @name={{t "operations.common.quantity"}}>
                    <Input @value={{this.newPickItem.quantity_requested}} @type="number" class="w-full form-input" placeholder="Qty" />
                </InputGroup>

            </div>
        </Overlay::Body>
    </Overlay>
{{/if}}