<div class="details-wrapper" ...attributes>
    <ContentPanel @title={{t "operations.waves.sections.details"}} @open={{true}} @wrapperClass="bordered-top">
        <div class="text-xs">
            <div class="pallet-field-group-heading">{{t "inventory.groups.identity"}}</div>
            <div class="field-info-container field-vertical-container dashed-bottom">
                <div class="field-name">{{t "common.id"}}</div>
                <ClickToCopy @value={{@resource.public_id}} class="field-value font-mono">{{n-a @resource.public_id}}</ClickToCopy>
            </div>
            <div class="field-info-container field-vertical-container dashed-bottom">
                <div class="field-name">{{t "operations.waves.columns.wave"}}</div>
                <ClickToCopy @value={{@resource.wave_number}} class="field-value font-mono">{{n-a @resource.wave_number}}</ClickToCopy>
            </div>
            <div class="field-info-container field-vertical-container dashed-bottom">
                <div class="field-name">{{t "common.status"}}</div>
                <div class="field-value"><Badge @status={{@resource.status}}>{{smart-humanize @resource.status}}</Badge></div>
            </div>
            <div class="field-info-container field-vertical-container">
                <div class="field-name">{{t "common.type"}}</div>
                <div class="field-value">{{n-a (smart-humanize @resource.type)}}</div>
            </div>

            <div class="pallet-field-group-heading">{{t "operations.waves.groups.scheduling"}}</div>
            <div class="field-info-container field-vertical-container dashed-bottom">
                <div class="field-name">{{t "operations.common.warehouse"}}</div>
                <div class="field-value">{{n-a @resource.warehouse.name}}</div>
            </div>
            <div class="field-info-container field-vertical-container dashed-bottom">
                <div class="field-name">{{t "operations.waves.scheduled-at"}}</div>
                <div class="field-value">{{n-a (format-date @resource.scheduled_at)}}</div>
            </div>
            <div class="field-info-container field-vertical-container dashed-bottom">
                <div class="field-name">{{t "operations.waves.started-at"}}</div>
                <div class="field-value">{{n-a (format-date @resource.started_at)}}</div>
            </div>
            <div class="field-info-container field-vertical-container{{if @resource.notes ' dashed-bottom'}}">
                <div class="field-name">{{t "operations.waves.completed-at"}}</div>
                <div class="field-value">{{n-a (format-date @resource.completed_at)}}</div>
            </div>
            {{#if @resource.notes}}
                <div class="field-info-container field-vertical-container">
                    <div class="field-name">{{t "common.notes"}}</div>
                    <div class="field-value">{{@resource.notes}}</div>
                </div>
            {{/if}}
        </div>
    </ContentPanel>

    {{!
        The server's completed_pick_lists / total_pick_lists count lists, not the work
        inside them — a wave reads 0 / 2 while most of its lines are already picked.
        Both facts are worth having, so both are here.
    }}
    <ContentPanel @title={{t "operations.waves.sections.progress"}} @open={{true}} @wrapperClass="bordered-top">
        <div class="grid grid-cols-2 gap-3 text-xs sm:grid-cols-4">
            <div class="field-info-container">
                <div class="field-name">{{t "operations.waves.fields.lists-complete"}}</div>
                <div class="field-value tabular-nums">{{this.picking.listsComplete}}<span class="text-gray-400"> / {{this.picking.lists}}</span></div>
            </div>
            <div class="field-info-container">
                <div class="field-name">{{t "operations.waves.fields.lines"}}</div>
                <div class="field-value tabular-nums">{{format-number this.picking.lines}}</div>
            </div>
            <div class="field-info-container">
                <div class="field-name">{{t "operations.waves.fields.picked"}}</div>
                <div class="field-value tabular-nums">{{format-number this.picking.picked}}</div>
            </div>
            <div class="field-info-container">
                <div class="field-name">{{t "operations.waves.fields.outstanding"}}</div>
                <div class="field-value tabular-nums">
                    <span class={{if this.picking.outstanding "text-amber-600 dark:text-amber-300"}}>{{format-number this.picking.outstanding}}</span>
                </div>
            </div>
        </div>
    </ContentPanel>

    <ContentPanel @title={{t "operations.waves.sections.pick-lists"}} @open={{true}} @wrapperClass="bordered-top" @panelBodyWrapperClass="px-0i">
        {{#if @resource.pickLists.length}}
            <table class="w-full text-xs dark:text-gray-100">
                <thead>
                    <tr class="whitespace-nowrap border-b border-gray-200 text-left uppercase text-gray-500 dark:border-gray-700">
                        <th class="w-1/3 px-3 py-2">{{t "operations.pick-lists.columns.pick-list"}}</th>
                        <th class="px-3 py-2">{{t "common.status"}}</th>
                        <th class="px-3 py-2 text-right">{{t "operations.waves.fields.lines"}}</th>
                        <th class="px-3 py-2 text-right">{{t "operations.waves.fields.picked"}}</th>
                        <th class="px-3 py-2 text-right">{{t "operations.pick-lists.columns.progress"}}</th>
                    </tr>
                </thead>
                <tbody>
                    {{#each @resource.pickLists as |list|}}
                        <tr class="border-b border-gray-100 dark:border-gray-800">
                            <td class="px-3 py-2 font-mono">{{n-a list.pick_list_number}}</td>
                            <td class="px-3 py-2"><Badge @status={{list.status}}>{{smart-humanize list.status}}</Badge></td>
                            <td class="px-3 py-2 text-right tabular-nums">{{format-number list.total_items}}</td>
                            <td class="px-3 py-2 text-right tabular-nums">{{format-number list.picked_items}}</td>
                            <td class="px-3 py-2 text-right tabular-nums">{{list.completion_percentage}}%</td>
                        </tr>
                    {{/each}}
                </tbody>
            </table>
        {{else}}
            {{! A pending wave has no pick lists until it is released — that is the state, not an error. }}
            <div class="px-3 py-6 text-xs text-gray-500 dark:text-gray-400">{{t "operations.waves.no-pick-lists"}}</div>
        {{/if}}
    </ContentPanel>

    <ContentPanel @title={{t "common.metadata"}} @open={{false}} @wrapperClass="bordered-top" @panelBodyWrapperClass={{unless (is-object-empty @resource.meta) "px-0i" ""}}>
        <MetadataViewer @metadata={{@resource.meta}} />
    </ContentPanel>
</div>
