<div class="text-xs" ...attributes {{did-insert (perform this.load)}}>
    {{#if this.load.isRunning}}
        <div class="px-3 py-4"><Spinner /></div>
    {{else if this.rows.length}}
        <table class="w-full dark:text-gray-100">
            <thead>
                <tr class="whitespace-nowrap border-b border-gray-200 text-left uppercase text-gray-500 dark:border-gray-700">
                    <th class="px-3 py-2">{{t "operations.common.warehouse"}}</th>
                    <th class="px-3 py-2 text-right">{{t "product.columns.on-hand"}}</th>
                    <th class="px-3 py-2 text-right">{{t "product.columns.reserved"}}</th>
                    <th class="px-3 py-2 text-right">{{t "product.columns.available"}}</th>
                </tr>
            </thead>
            <tbody>
                {{#each this.rows key="key" as |row|}}
                    <tr class="border-b border-gray-100 dark:border-gray-800">
                        <td class="px-3 py-2">{{n-a row.name}}</td>
                        <td class="px-3 py-2 text-right tabular-nums">{{format-number row.onHand}}</td>
                        <td class="px-3 py-2 text-right tabular-nums">{{format-number row.reserved}}</td>
                        <td class="px-3 py-2 text-right tabular-nums">{{format-number row.available}}</td>
                    </tr>
                {{/each}}
            </tbody>
        </table>
    {{else}}
        {{! A product with no inventory row anywhere is stocked nowhere — a real state,
            and different from a product whose stock is zero in one building. }}
        <div class="px-3 py-6 text-gray-500 dark:text-gray-400">{{t "product.no-warehouse-stock"}}</div>
    {{/if}}
</div>
