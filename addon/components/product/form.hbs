<div class="form-wrapper" ...attributes>
    <ContentPanel @title={{t "product.sections.details"}} @open={{true}} @wrapperClass="bordered-top">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-2 text-xs no-input-group-padding">
            <InputGroup @name={{t "common.name"}} @wrapperClass="col-span-2">
                <Input @value={{@resource.name}} @type="text" class="w-full form-input" placeholder={{t "product.fields.name-placeholder"}} disabled={{cannot-write @resource}} />
            </InputGroup>

            <InputGroup @name={{t "common.internal-id"}}>
                <Input @value={{@resource.internal_id}} @type="text" class="w-full form-input" placeholder={{t "common.internal-id"}} disabled={{cannot-write @resource}} />
            </InputGroup>

            <InputGroup @name={{t "product.fields.sku"}}>
                <Input @value={{@resource.sku}} @type="text" class="w-full form-input" placeholder={{t "product.fields.sku"}} disabled={{cannot-write @resource}} />
            </InputGroup>

            <InputGroup @name={{t "product.fields.barcode"}}>
                <Input @value={{@resource.barcode}} @type="text" class="w-full form-input" placeholder={{t "product.fields.barcode"}} disabled={{cannot-write @resource}} />
            </InputGroup>

            <InputGroup @name="Storefront Product UUID" @wrapperClass="col-span-2">
                <Input @value={{@resource.storefront_product_uuid}} @type="text" class="w-full form-input" placeholder="Linked Storefront product UUID" disabled={{cannot-write @resource}} />
            </InputGroup>

            <InputGroup @name={{t "product.fields.category"}}>
                <div class="fleetbase-model-select fleetbase-power-select ember-model-select">
                    <PowerSelect
                        @options={{this.productCategories}}
                        @selected={{@resource.category}}
                        @onChange={{fn (mut @resource.category)}}
                        @placeholder={{t "product.fields.select-category"}}
                        @triggerClass="form-select form-input"
                        @disabled={{or (cannot-write @resource) (not this.productCategories)}}
                        as |category|
                    >
                        {{smart-humanize category}}
                    </PowerSelect>
                </div>
            </InputGroup>

            <InputGroup @name={{t "product.fields.supplier"}}>
                <ModelSelect
                    @modelName="vendor"
                    @selectedModel={{@resource.supplier}}
                    @placeholder={{t "product.fields.select-supplier"}}
                    @triggerClass="form-select form-input"
                    @infiniteScroll={{false}}
                    @renderInPlace={{true}}
                    @onChange={{fn (mut @resource.supplier)}}
                    @onChangeId={{fn (mut @resource.supplier_uuid)}}
                    @disabled={{cannot-write @resource}}
                    as |model|
                >
                    {{model.name}}
                </ModelSelect>
            </InputGroup>

            <InputGroup @name={{t "common.status"}}>
                <div class="fleetbase-model-select fleetbase-power-select ember-model-select">
                    <PowerSelect
                        @options={{this.statusOptions}}
                        @selected={{find-by "value" @resource.status this.statusOptions}}
                        @onChange={{set-model-attr @resource "status"}}
                        @placeholder={{t "common.select-status"}}
                        @triggerClass="form-select form-input"
                        @disabled={{cannot-write @resource}}
                        as |option|
                    >
                        {{option.label}}
                    </PowerSelect>
                </div>
            </InputGroup>

            <InputGroup @name={{t "common.description"}} @wrapperClass="col-span-2">
                <Textarea @value={{@resource.description}} class="w-full form-input" placeholder={{t "common.description"}} disabled={{cannot-write @resource}} />
            </InputGroup>
        </div>
    </ContentPanel>

    <ContentPanel @title={{t "product.sections.inventory-settings"}} @open={{true}} @wrapperClass="bordered-top">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-2 text-xs no-input-group-padding">
            <InputGroup @name={{t "product.fields.reorder-point"}}>
                <Input @value={{@resource.reorder_point}} @type="number" class="w-full form-input" placeholder={{t "product.fields.reorder-point"}} disabled={{cannot-write @resource}} />
            </InputGroup>

            <InputGroup @name={{t "product.fields.reorder-quantity"}}>
                <Input @value={{@resource.reorder_quantity}} @type="number" class="w-full form-input" placeholder={{t "product.fields.reorder-quantity"}} disabled={{cannot-write @resource}} />
            </InputGroup>

            <InputGroup @name={{t "product.fields.shelf-life-days"}}>
                <Input @value={{@resource.shelf_life_days}} @type="number" class="w-full form-input" placeholder={{t "product.fields.shelf-life-days"}} disabled={{cannot-write @resource}} />
            </InputGroup>

            <InputGroup @name={{t "product.fields.is-serialized"}}>
                <Checkbox @checked={{@resource.is_serialized}} @onChange={{fn (mut @resource.is_serialized)}} @disabled={{cannot-write @resource}}>
                    {{t "product.fields.track-serial-numbers"}}
                </Checkbox>
            </InputGroup>

            <InputGroup @name={{t "product.fields.is-lot-tracked"}}>
                <Checkbox @checked={{@resource.is_lot_tracked}} @onChange={{fn (mut @resource.is_lot_tracked)}} @disabled={{cannot-write @resource}}>
                    {{t "product.fields.track-lot-numbers"}}
                </Checkbox>
            </InputGroup>

            <InputGroup @name={{t "product.fields.is-perishable"}}>
                <Checkbox @checked={{@resource.is_perishable}} @onChange={{fn (mut @resource.is_perishable)}} @disabled={{cannot-write @resource}}>
                    {{t "product.fields.perishable-item"}}
                </Checkbox>
            </InputGroup>

            <InputGroup @name={{t "product.fields.requires-quality-check"}}>
                <Checkbox @checked={{@resource.requires_quality_check}} @onChange={{fn (mut @resource.requires_quality_check)}} @disabled={{cannot-write @resource}}>
                    {{t "product.fields.requires-qc"}}
                </Checkbox>
            </InputGroup>

            <InputGroup @name="Variants">
                <Checkbox @checked={{@resource.has_variants}} @onChange={{fn (mut @resource.has_variants)}} @disabled={{cannot-write @resource}}>
                    Track stock by product variants
                </Checkbox>
            </InputGroup>
        </div>
    </ContentPanel>

    <ContentPanel @title="Variants" @open={{true}} @wrapperClass="bordered-top">
        {{#if this.canManageVariants}}
            <div class="space-y-3 text-xs">
                {{#if this.variants.length}}
                    <table class="w-full">
                        <thead>
                            <tr class="border-b border-gray-100 dark:border-gray-700 text-gray-500 dark:text-gray-400">
                                <th class="text-left py-2 pr-2 font-medium">Variant</th>
                                <th class="text-left py-2 px-2 font-medium">SKU</th>
                                <th class="text-right py-2 px-2 font-medium">Available</th>
                                <th class="py-2 pl-2"></th>
                            </tr>
                        </thead>
                        <tbody>
                            {{#each this.variants as |variant|}}
                                <tr class="border-b border-gray-100 dark:border-gray-800">
                                    <td class="py-2 pr-2 font-medium">{{n-a variant.display_name variant.name}}</td>
                                    <td class="py-2 px-2 text-gray-500">{{n-a variant.sku}}</td>
                                    <td class="py-2 px-2 text-right">{{format-number variant.available_stock}}</td>
                                    <td class="py-2 pl-2">
                                        <div class="flex justify-end gap-1">
                                            <Button @icon="pen" @type="default" @size="xs" @onClick={{fn this.startEditingVariant variant}} @helpText="Edit variant" />
                                            <Button @icon="trash" @type="danger" @size="xs" @onClick={{fn this.removeVariant variant}} @helpText="Remove variant" />
                                        </div>
                                    </td>
                                </tr>
                            {{/each}}
                        </tbody>
                    </table>
                {{/if}}

                {{#if this.editingVariant}}
                    <div class="grid grid-cols-1 lg:grid-cols-7 gap-2 p-3 bg-blue-50 dark:bg-blue-900/20">
                        <Input @value={{this.editingVariant.name}} class="form-input" placeholder="Variant name" />
                        <Input @value={{this.editingVariant.sku}} class="form-input" placeholder="SKU" />
                        <Input @value={{this.editingVariant.barcode}} class="form-input" placeholder="Barcode" />
                        <Input @value={{this.editingVariant.storefront_variant_uuid}} class="form-input" placeholder="Storefront variant UUID" />
                        <Input @value={{this.editingVariant.option_values_text}} class="form-input lg:col-span-2" placeholder="Color=Black, Storage=256GB" />
                        <div class="flex gap-1">
                            <Button @icon="check" @type="primary" @size="sm" @onClick={{this.saveVariant}} />
                            <Button @icon="times" @type="default" @size="sm" @onClick={{this.cancelEditingVariant}} />
                        </div>
                    </div>
                {{/if}}

                {{#if this.isAddingVariant}}
                    <div class="grid grid-cols-1 lg:grid-cols-7 gap-2 p-3 bg-green-50 dark:bg-green-900/20">
                        <Input @value={{this.newVariant.name}} class="form-input" placeholder="Variant name" />
                        <Input @value={{this.newVariant.sku}} class="form-input" placeholder="SKU" />
                        <Input @value={{this.newVariant.barcode}} class="form-input" placeholder="Barcode" />
                        <Input @value={{this.newVariant.storefront_variant_uuid}} class="form-input" placeholder="Storefront variant UUID" />
                        <Input @value={{this.newVariant.option_values_text}} class="form-input lg:col-span-2" placeholder="Color=Black, Storage=256GB" />
                        <div class="flex gap-1">
                            <Button @icon="plus" @type="primary" @size="sm" @onClick={{this.addVariant}} />
                            <Button @icon="times" @type="default" @size="sm" @onClick={{this.cancelAddingVariant}} />
                        </div>
                    </div>
                {{else}}
                    <Button @icon="plus" @type="default" @size="sm" @text="Add Variant" @onClick={{this.startAddingVariant}} @disabled={{cannot-write @resource}} />
                {{/if}}
            </div>
        {{else}}
            <div class="text-xs text-gray-500 dark:text-gray-400">Save the product before adding variants.</div>
        {{/if}}
    </ContentPanel>

    <ContentPanel @title={{t "product.sections.pricing"}} @open={{true}} @wrapperClass="bordered-top">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-2 text-xs no-input-group-padding">
            <InputGroup @name={{t "product.fields.unit-cost"}}>
                <MoneyInput
                    class="w-full"
                    @value={{@resource.unit_cost}}
                    @currency={{@resource.currency}}
                    @canSelectCurrency={{true}}
                    @onCurrencyChange={{fn (mut @resource.currency)}}
                    @disabled={{cannot-write @resource}}
                />
            </InputGroup>

            <InputGroup @name={{t "product.fields.unit-price"}}>
                <MoneyInput
                    class="w-full"
                    @value={{@resource.unit_price}}
                    @currency={{@resource.currency}}
                    @canSelectCurrency={{true}}
                    @onCurrencyChange={{fn (mut @resource.currency)}}
                    @disabled={{cannot-write @resource}}
                />
            </InputGroup>

            <InputGroup @name={{t "product.fields.sale-price"}}>
                <MoneyInput
                    class="w-full"
                    @value={{@resource.sale_price}}
                    @currency={{@resource.currency}}
                    @canSelectCurrency={{true}}
                    @onCurrencyChange={{fn (mut @resource.currency)}}
                    @disabled={{cannot-write @resource}}
                />
            </InputGroup>

            <InputGroup @name={{t "product.fields.declared-value"}}>
                <MoneyInput
                    class="w-full"
                    @value={{@resource.declared_value}}
                    @currency={{@resource.currency}}
                    @canSelectCurrency={{true}}
                    @onCurrencyChange={{fn (mut @resource.currency)}}
                    @disabled={{cannot-write @resource}}
                />
            </InputGroup>
        </div>
    </ContentPanel>

    <ContentPanel @title={{t "product.sections.dimensions"}} @open={{true}} @wrapperClass="bordered-top">
        <div class="grid grid-cols-3 gap-2 text-xs no-input-group-padding mb-2">
            <InputGroup @name={{t "common.length"}}>
                <UnitInput
                    class="w-full"
                    @measurement="length"
                    @value={{@resource.length}}
                    @unit={{@resource.dimensions_unit}}
                    @canSelectUnit={{true}}
                    @onUnitChange={{fn (mut @resource.dimensions_unit)}}
                    @disabled={{cannot-write @resource}}
                />
            </InputGroup>

            <InputGroup @name={{t "common.width"}}>
                <UnitInput
                    class="w-full"
                    @measurement="length"
                    @value={{@resource.width}}
                    @unit={{@resource.dimensions_unit}}
                    @canSelectUnit={{true}}
                    @onUnitChange={{fn (mut @resource.dimensions_unit)}}
                    @disabled={{cannot-write @resource}}
                />
            </InputGroup>

            <InputGroup @name={{t "common.height"}}>
                <UnitInput
                    class="w-full"
                    @measurement="length"
                    @value={{@resource.height}}
                    @unit={{@resource.dimensions_unit}}
                    @canSelectUnit={{true}}
                    @onUnitChange={{fn (mut @resource.dimensions_unit)}}
                    @disabled={{cannot-write @resource}}
                />
            </InputGroup>
        </div>

        <div class="grid grid-cols-3 gap-2 text-xs no-input-group-padding">
            <InputGroup @name={{t "common.weight"}}>
                <UnitInput
                    class="w-full"
                    @measurement="weight"
                    @value={{@resource.weight}}
                    @unit={{@resource.weight_unit}}
                    @canSelectUnit={{true}}
                    @onUnitChange={{fn (mut @resource.weight_unit)}}
                    @disabled={{cannot-write @resource}}
                />
            </InputGroup>
        </div>
    </ContentPanel>

    <CustomField::Yield @subject={{@resource}} @wrapperClass="bordered-top" />

    <ContentPanel @title={{t "common.metadata"}} @open={{true}} @wrapperClass="bordered-top">
        <MetadataEditor @value={{@resource.meta}} @onChange={{fn (mut @resource.meta)}} />
    </ContentPanel>
</div>
