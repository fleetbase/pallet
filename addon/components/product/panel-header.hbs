<div class="flex flex-row items-center justify-between" ...attributes>
    <div class="flex flex-row items-center">
        <div class="mr-3">
            <Image src={{@resource.photo_url}} @fallbackSrc={{config "defaultValues.productImage"}} alt={{@resource.name}} class="w-12 h-12 rounded-md shadow-sm" />
        </div>
        <div class="flex flex-col">
            <div class="text-lg font-semibold">{{@resource.name}}</div>
            <div class="text-xs text-gray-600 dark:text-gray-400">
                {{#if @resource.sku}}
                    <span class="mr-2">SKU: {{@resource.sku}}</span>
                {{/if}}
                {{#if @resource.category}}
                    <span>{{smart-humanize @resource.category}}</span>
                {{/if}}
            </div>
        </div>
    </div>
    <div class="flex flex-row items-center space-x-2">
        <Badge @status={{@resource.status}}>{{smart-humanize @resource.status}}</Badge>
        {{#if @resource.is_serialized}}
            <Badge @status="info" @hideStatusDot={{true}}>{{t "product.fields.serialized"}}</Badge>
        {{/if}}
        {{#if @resource.is_lot_tracked}}
            <Badge @status="info" @hideStatusDot={{true}}>{{t "product.fields.lot-tracked"}}</Badge>
        {{/if}}
    </div>
</div>
