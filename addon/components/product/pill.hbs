<div class="flex flex-row items-center space-x-2 px-2 py-1 bg-gray-100 dark:bg-gray-700 rounded-md" ...attributes>
    <Image src={{@resource.photo_url}} @fallbackSrc={{config "defaultValues.placeholderImage"}} alt={{@resource.name}} class="w-6 h-6 rounded" />
    <span class="text-sm font-medium">{{@resource.name}}</span>
    {{#if @resource.sku}}
        <span class="text-xs text-gray-500 dark:text-gray-400">({{@resource.sku}})</span>
    {{/if}}
</div>
