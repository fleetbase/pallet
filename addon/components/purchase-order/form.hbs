<div class="form-wrapper" ...attributes>
    <ContentPanel @title={{t "purchase-order.sections.details"}} @open={{true}} @wrapperClass="bordered-top">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-2 text-xs no-input-group-padding">
            <InputGroup @name={{t "purchase-order.fields.order-number"}} @wrapperClass="col-span-2">
                <Input @value={{@resource.order_number}} @type="text" class="w-full form-input" placeholder={{t "purchase-order.fields.order-number"}} disabled={{cannot-write @resource}} />
            </InputGroup>
            <InputGroup @name={{t "purchase-order.fields.supplier"}}>
                <ModelSelect
                    @modelName="supplier"
                    @selectedModel={{@resource.supplier}}
                    @placeholder={{t "purchase-order.fields.select-supplier"}}
                    @triggerClass="form-select form-input"
                    @infiniteScroll={{false}}
                    @renderInPlace={{true}}
                    @onChange={{this.setSupplier}}
                    @disabled={{cannot-write @resource}}
                    as |model|
                >
                    {{model.name}}
                </ModelSelect>
            </InputGroup>
            <InputGroup @name={{t "purchase-order.fields.warehouse"}}>
                <ModelSelect
                    @modelName="warehouse"
                    @selectedModel={{@resource.warehouse}}
                    @placeholder={{t "purchase-order.fields.select-warehouse"}}
                    @triggerClass="form-select form-input"
                    @infiniteScroll={{false}}
                    @renderInPlace={{true}}
                    @onChange={{this.setWarehouse}}
                    @disabled={{cannot-write @resource}}
                    as |model|
                >
                    {{model.name}}
                </ModelSelect>
            </InputGroup>
            <InputGroup @name={{t "common.status"}}>
                <div class="fleetbase-model-select fleetbase-power-select ember-model-select">
                    <PowerSelect
                        @options={{this.statusOptions}}
                        @selected={{find-by "value" @resource.status this.statusOptions}}
                        @onChange={{set-model-attr @resource "status"}}
                        @placeholder={{t "common.select-status"}}
                        @triggerClass="form-select form-input"
                        @disabled={{cannot-write @resource}}
                        as |option|
                    >
                        {{option.label}}
                    </PowerSelect>
                </div>
            </InputGroup>
            <InputGroup @name={{t "purchase-order.fields.expected-delivery"}}>
                <Input @value={{@resource.expected_delivery_at}} @type="date" class="w-full form-input" disabled={{cannot-write @resource}} />
            </InputGroup>
            <InputGroup @name={{t "common.notes"}} @wrapperClass="col-span-2">
                <Textarea @value={{@resource.comments}} class="w-full form-input" placeholder={{t "common.notes"}} disabled={{cannot-write @resource}} />
            </InputGroup>
        </div>
    </ContentPanel>
    <CustomField::Yield @subject={{@resource}} @wrapperClass="bordered-top" />
    <ContentPanel @title={{t "common.metadata"}} @open={{true}} @wrapperClass="bordered-top">
        <MetadataEditor @value={{@resource.meta}} @onChange={{fn (mut @resource.meta)}} />
    </ContentPanel>
</div>
