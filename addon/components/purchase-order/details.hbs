<div class="details-wrapper" ...attributes>
    <ContentPanel @title={{t "purchase-order.sections.details"}} @open={{true}} @wrapperClass="bordered-top">
        <div class="grid grid-cols-2 gap-2 text-xs dark:text-gray-100">
            <div class="field-info-container">
                <div class="field-name">{{t "common.id"}}</div>
                <ClickToCopy @value={{@resource.public_id}} class="field-value">{{n-a @resource.public_id}}</ClickToCopy>
            </div>
            <div class="field-info-container">
                <div class="field-name">{{t "purchase-order.fields.order-number"}}</div>
                <ClickToCopy @value={{@resource.order_number}} class="field-value">{{n-a @resource.order_number}}</ClickToCopy>
            </div>
            <div class="field-info-container">
                <div class="field-name">{{t "purchase-order.fields.supplier"}}</div>
                <div class="field-value">{{n-a @resource.supplier.name}}</div>
            </div>
            <div class="field-info-container">
                <div class="field-name">{{t "purchase-order.fields.warehouse"}}</div>
                <div class="field-value">{{n-a @resource.warehouse.name}}</div>
            </div>
            <div class="field-info-container">
                <div class="field-name">{{t "common.status"}}</div>
                <div class="field-value">
                    <Badge @status={{@resource.status}}>{{smart-humanize @resource.status}}</Badge>
                </div>
            </div>
            <div class="field-info-container">
                <div class="field-name">{{t "purchase-order.fields.expected-delivery"}}</div>
                <div class="field-value">{{format-date @resource.expected_delivery_at}}</div>
            </div>
            <div class="field-info-container md:col-span-2">
                <div class="field-name">{{t "common.notes"}}</div>
                <div class="field-value">{{n-a @resource.comments}}</div>
            </div>
        </div>
    </ContentPanel>
    <ContentPanel @title={{t "purchase-order.sections.line-items"}} @open={{true}} @wrapperClass="bordered-top" @panelBodyWrapperClass="px-0i">
        {{#if @resource.items.length}}
            {{! The details panel is narrow, so the item table scrolls rather than clipping its pricing columns. }}
            <div class="overflow-x-auto">
            <table class="w-full text-sm whitespace-nowrap">
                <thead>
                    <tr class="border-b border-gray-200 dark:border-gray-700 text-left text-xs uppercase text-gray-500">
                        <th class="px-4 py-3">{{t "columns.product"}}</th>
                        <th class="px-4 py-3">{{t "columns.product-sku"}}</th>
                        <th class="px-4 py-3">{{t "common.status"}}</th>
                        <th class="px-4 py-3 text-right">{{t "columns.quantity"}}</th>
                        <th class="px-4 py-3 text-right">{{t "columns.received"}}</th>
                        <th class="px-4 py-3 text-right">{{t "columns.outstanding"}}</th>
                        <th class="px-4 py-3 text-right">{{t "columns.unit-price"}}</th>
                        <th class="px-4 py-3 text-right">{{t "columns.total"}}</th>
                    </tr>
                </thead>
                <tbody>
                    {{#each @resource.items as |item|}}
                        <tr class="border-b border-gray-100 dark:border-gray-800">
                            <td class="px-4 py-3 font-medium">{{n-a item.product.name}}</td>
                            <td class="px-4 py-3">{{n-a (or item.sku item.product.sku)}}</td>
                            <td class="px-4 py-3"><Badge @status={{item.status}}>{{smart-humanize item.status}}</Badge></td>
                            <td class="px-4 py-3 text-right">{{item.quantity}}</td>
                            <td class="px-4 py-3 text-right">{{item.quantity_received}}</td>
                            <td class="px-4 py-3 text-right">{{item.outstanding_quantity}}</td>
                            <td class="px-4 py-3 text-right">{{format-currency item.unit_price item.currency}}</td>
                            <td class="px-4 py-3 text-right">{{format-currency item.total_price item.currency}}</td>
                        </tr>
                    {{/each}}
                </tbody>
            </table>
            </div>
        {{else}}
            <div class="px-4 py-6 text-sm text-gray-500 dark:text-gray-400">{{t "purchase-order.no-line-items"}}</div>
        {{/if}}
    </ContentPanel>
    <CustomField::Yield @subject={{@resource}} @viewMode={{true}} @wrapperClass="bordered-top" />
    <ContentPanel @title={{t "common.metadata"}} @open={{true}} @wrapperClass="bordered-top" @panelBodyWrapperClass={{unless (is-object-empty @resource.meta) "px-0i" ""}}>
        <MetadataViewer @metadata={{@resource.meta}} />
    </ContentPanel>
</div>
