<div class="pallet-dashboard-widget flex h-full min-h-0 flex-col overflow-hidden rounded-md border bg-white shadow-sm dark:bg-gray-800" ...attributes>
    <div class="pallet-widget-header">
        <div>
            <div class="pallet-widget-title">{{t "widgets.titles.inventory-summary"}}</div>
            <div class="pallet-widget-subtitle">{{t "widgets.subtitles.inventory-summary"}}</div>
        </div>
        <FaIcon @icon="boxes-stacked" class="text-gray-400" />
    </div>

    {{#if this.loadMetrics.isRunning}}
        <div class="pallet-widget-empty"><Spinner /></div>
    {{else}}
        <div class="pallet-widget-scroll-body">
            <div class="grid h-full min-h-0 grid-cols-2 gap-3 md:grid-cols-5">
                <div class="flex min-w-0 flex-col items-center justify-center rounded-md bg-blue-50 p-3 text-center dark:bg-blue-900/20">
                    <FaIcon @icon="boxes-stacked" class="mb-2 text-xl text-blue-500" />
                    <span class="text-xl font-bold text-gray-800 dark:text-gray-100">{{this.totalSkus}}</span>
                    <span class="mt-1 truncate text-xs text-gray-500 dark:text-gray-400">{{t "widgets.labels.total-skus"}}</span>
                </div>
                <div class="flex min-w-0 flex-col items-center justify-center rounded-md bg-green-50 p-3 text-center dark:bg-green-900/20">
                    <FaIcon @icon="cubes" class="mb-2 text-xl text-green-500" />
                    <span class="text-xl font-bold text-gray-800 dark:text-gray-100">{{this.totalUnits}}</span>
                    <span class="mt-1 truncate text-xs text-gray-500 dark:text-gray-400">{{t "widgets.labels.total-units"}}</span>
                </div>
                <div class="flex min-w-0 flex-col items-center justify-center rounded-md bg-purple-50 p-3 text-center dark:bg-purple-900/20">
                    <FaIcon @icon="dollar-sign" class="mb-2 text-xl text-purple-500" />
                    <span class="text-xl font-bold text-gray-800 dark:text-gray-100">{{this.totalValue}}</span>
                    <span class="mt-1 truncate text-xs text-gray-500 dark:text-gray-400">{{t "widgets.labels.stock-value"}}</span>
                </div>
                <div class="flex min-w-0 flex-col items-center justify-center rounded-md bg-yellow-50 p-3 text-center dark:bg-yellow-900/20">
                    <FaIcon @icon="warehouse" class="mb-2 text-xl text-yellow-500" />
                    <span class="text-xl font-bold text-gray-800 dark:text-gray-100">{{this.warehouseCount}}</span>
                    <span class="mt-1 truncate text-xs text-gray-500 dark:text-gray-400">{{t "widgets.labels.warehouses"}}</span>
                </div>
                <div class="flex min-w-0 flex-col items-center justify-center rounded-md bg-red-50 p-3 text-center dark:bg-red-900/20">
                    <FaIcon @icon="triangle-exclamation" class="mb-2 text-xl text-red-500" />
                    <span class="text-xl font-bold text-gray-800 dark:text-gray-100">{{this.lowStockCount}}</span>
                    <span class="mt-1 truncate text-xs text-gray-500 dark:text-gray-400">{{t "widgets.labels.low-stock"}}</span>
                </div>
            </div>
        </div>
    {{/if}}
</div>