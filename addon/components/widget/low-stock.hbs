<div class="flex flex-col h-full overflow-hidden">
    {{#if this.isLoading}}
        <div class="flex items-center justify-center h-full">
            <Spinner />
        </div>
    {{else if (eq this.items.length 0)}}
        <div class="flex flex-col items-center justify-center h-full text-gray-400 dark:text-gray-600">
            <FaIcon @icon="check-circle" class="text-green-400 text-3xl mb-2" />
            <span class="text-sm">All stock levels are healthy</span>
        </div>
    {{else}}
        <div class="overflow-y-auto flex-1">
            <table class="w-full text-xs">
                <thead class="sticky top-0 bg-white dark:bg-gray-900 z-10">
                    <tr class="border-b border-gray-100 dark:border-gray-700 text-gray-500 dark:text-gray-400">
                        <th class="text-left px-3 py-2 font-medium">Product</th>
                        <th class="text-left px-3 py-2 font-medium">SKU</th>
                        <th class="text-right px-3 py-2 font-medium">In Stock</th>
                        <th class="text-right px-3 py-2 font-medium">Min</th>
                    </tr>
                </thead>
                <tbody>
                    {{#each this.items as |item|}}
                        <tr class="border-b border-gray-50 dark:border-gray-800 hover:bg-gray-50 dark:hover:bg-gray-800/50">
                            <td class="px-3 py-2 font-medium text-gray-800 dark:text-gray-100 truncate max-w-[120px]">
                                {{n-a item.name}}
                            </td>
                            <td class="px-3 py-2 text-gray-500 dark:text-gray-400">{{n-a item.sku}}</td>
                            <td class="px-3 py-2 text-right">
                                <span class="font-semibold {{if (eq item.quantity 0) 'text-red-600' 'text-orange-500'}}">
                                    {{item.quantity}}
                                </span>
                            </td>
                            <td class="px-3 py-2 text-right text-gray-500 dark:text-gray-400">{{item.min_stock}}</td>
                        </tr>
                    {{/each}}
                </tbody>
            </table>
        </div>
    {{/if}}
</div>
