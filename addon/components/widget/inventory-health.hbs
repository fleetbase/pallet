<div class="pallet-dashboard-widget flex h-full min-h-0 flex-col overflow-hidden rounded-md border bg-white shadow-sm dark:bg-gray-800" ...attributes>
    <div class="pallet-widget-header">
        <div>
            <div class="pallet-widget-title">{{t "widgets.titles.inventory-health"}}</div>
            <div class="pallet-widget-subtitle">{{this.total}} tracked inventory records</div>
        </div>
        <FaIcon @icon="heart-pulse" class="text-gray-400" />
    </div>
    <div class="pallet-widget-body">
        {{#if this.error}}
            <div class="pallet-widget-empty">{{this.error}}</div>
        {{else if this.load.isRunning}}
            <div class="pallet-widget-empty"><Spinner /></div>
        {{else}}
            <div class="space-y-3">
                {{#each this.items as |item|}}
                    <div class="flex items-center justify-between gap-3 rounded-md border border-gray-100 px-3 py-2 dark:border-gray-700">
                        <span class="truncate text-sm font-medium text-gray-700 dark:text-gray-200">{{item.label}}</span>
                        <Badge @status={{item.status}} @text={{item.value}} @hideIcon={{true}} @disableHumanize={{true}} />
                    </div>
                {{/each}}
            </div>
        {{/if}}
    </div>
</div>
