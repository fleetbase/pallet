{{!
    §A gives every widget a click-through to a pre-filtered list — the manager reading
    this screen came to find out what needs them today, and a tile reading "LOW STOCK 3"
    that cannot be clicked makes them go and find those three themselves.

    The link is a button stretched over the card rather than the card being conditionally
    a <button>: an element's opening and closing tags cannot straddle a conditional
    duplicating the whole body into both branches would mean maintaining it twice. This
    way the markup stays balanced, the whole card is the target, and it is a real button
    — focusable and operable by keyboard — instead of a div wearing a click handler.
}}
<div class="pallet-dashboard-widget pallet-kpi-tile {{this.accentClass}} relative flex h-full min-h-0 flex-col justify-between overflow-hidden rounded-md border shadow-sm p-3 {{if this.hasRoute 'transition hover:border-blue-400 hover:shadow-md dark:hover:border-blue-500'}}" ...attributes>
    {{#if this.hasRoute}}
        <button
            type="button"
            class="absolute inset-0 z-10 h-full w-full cursor-pointer rounded-md focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-500"
            aria-label={{@title}}
            {{on "click" this.openRoute}}
        ></button>
    {{/if}}

    <div class="flex items-start justify-between gap-3">
        <div class="min-w-0">
            <div class="pallet-kpi-title">{{@title}}</div>
            {{#if this.error}}
                <div class="mt-2 truncate text-xs font-semibold text-rose-600 dark:text-rose-300">{{this.error}}</div>
            {{else if this.load.isRunning}}
                <div class="mt-3"><Spinner /></div>
            {{else}}
                <div class="pallet-kpi-value mt-2 truncate">{{this.value}}</div>
            {{/if}}
        </div>
        <div class="pallet-kpi-icon">
            <FaIcon @icon={{@icon}} @prefix={{or @iconPrefix "fas"}} />
        </div>
    </div>

    <div class="pallet-kpi-footer flex items-center justify-between gap-2">
        <span class="truncate">{{this.footnote}}</span>
        {{#if this.hasRoute}}
            <FaIcon @icon="arrow-right" class="shrink-0 opacity-50" />
        {{/if}}
    </div>
</div>
