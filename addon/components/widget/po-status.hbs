<div class="flex flex-col h-full overflow-hidden">
    {{#if this.isLoading}}
        <div class="flex items-center justify-center h-full">
            <Spinner />
        </div>
    {{else}}
        {{! Status summary badges }}
        <div class="grid grid-cols-2 gap-2 p-3 border-b border-gray-100 dark:border-gray-700">
            <div class="flex items-center gap-2 bg-yellow-50 dark:bg-yellow-900/20 rounded-lg px-3 py-2">
                <FaIcon @icon="clock" class="text-yellow-500 text-sm" />
                <div>
                    <div class="text-lg font-bold text-gray-800 dark:text-gray-100">{{this.pending}}</div>
                    <div class="text-xs text-gray-500 dark:text-gray-400">Pending</div>
                </div>
            </div>
            <div class="flex items-center gap-2 bg-blue-50 dark:bg-blue-900/20 rounded-lg px-3 py-2">
                <FaIcon @icon="truck-ramp-box" class="text-blue-500 text-sm" />
                <div>
                    <div class="text-lg font-bold text-gray-800 dark:text-gray-100">{{this.partiallyReceived}}</div>
                    <div class="text-xs text-gray-500 dark:text-gray-400">Partial</div>
                </div>
            </div>
            <div class="flex items-center gap-2 bg-green-50 dark:bg-green-900/20 rounded-lg px-3 py-2">
                <FaIcon @icon="circle-check" class="text-green-500 text-sm" />
                <div>
                    <div class="text-lg font-bold text-gray-800 dark:text-gray-100">{{this.received}}</div>
                    <div class="text-xs text-gray-500 dark:text-gray-400">Received</div>
                </div>
            </div>
            <div class="flex items-center gap-2 bg-gray-50 dark:bg-gray-800 rounded-lg px-3 py-2">
                <FaIcon @icon="ban" class="text-gray-400 text-sm" />
                <div>
                    <div class="text-lg font-bold text-gray-800 dark:text-gray-100">{{this.cancelled}}</div>
                    <div class="text-xs text-gray-500 dark:text-gray-400">Cancelled</div>
                </div>
            </div>
        </div>

        {{! Recent orders list }}
        <div class="overflow-y-auto flex-1">
            {{#each this.recentOrders as |order|}}
                <div class="flex items-center justify-between px-3 py-2 border-b border-gray-50 dark:border-gray-800 hover:bg-gray-50 dark:hover:bg-gray-800/50">
                    <div class="flex flex-col">
                        <span class="text-xs font-medium text-gray-800 dark:text-gray-100">{{n-a order.public_id}}</span>
                        <span class="text-xs text-gray-400">{{n-a order.supplier_name}}</span>
                    </div>
                    <Badge @status={{order.status}} class="text-xs" />
                </div>
            {{/each}}
        </div>
    {{/if}}
</div>
