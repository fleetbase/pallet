<div class="pallet-dashboard-widget flex h-full min-h-0 flex-col overflow-hidden rounded-md border bg-white shadow-sm dark:bg-gray-800" ...attributes>
    <div class="pallet-widget-header">
        <div>
            <div class="pallet-widget-title">{{t "widgets.titles.purchase-order-status"}}</div>
            <div class="pallet-widget-subtitle">{{this.total}} purchase orders in the current workload</div>
        </div>
        <FaIcon @icon="truck-ramp-box" class="text-gray-400" />
    </div>

    {{#if this.error}}
        <div class="pallet-widget-empty">{{this.error}}</div>
    {{else if this.loadStatus.isRunning}}
        <div class="pallet-widget-empty"><Spinner /></div>
    {{else}}
        <div class="grid grid-cols-2 gap-2 border-b border-gray-100 p-3 dark:border-gray-700">
            <div class="flex min-w-0 items-center gap-2 rounded-md bg-yellow-50 px-3 py-2 dark:bg-yellow-900/20">
                <FaIcon @icon="clock" class="shrink-0 text-sm text-yellow-500" />
                <div class="min-w-0">
                    <div class="text-base font-bold text-gray-800 dark:text-gray-100">{{this.pending}}</div>
                    <div class="truncate text-xs text-gray-500 dark:text-gray-400">{{t "status.pending"}}</div>
                </div>
            </div>
            <div class="flex min-w-0 items-center gap-2 rounded-md bg-blue-50 px-3 py-2 dark:bg-blue-900/20">
                <FaIcon @icon="truck-ramp-box" class="shrink-0 text-sm text-blue-500" />
                <div class="min-w-0">
                    <div class="text-base font-bold text-gray-800 dark:text-gray-100">{{this.partiallyReceived}}</div>
                    <div class="truncate text-xs text-gray-500 dark:text-gray-400">{{t "status.partial"}}</div>
                </div>
            </div>
            <div class="flex min-w-0 items-center gap-2 rounded-md bg-green-50 px-3 py-2 dark:bg-green-900/20">
                <FaIcon @icon="circle-check" class="shrink-0 text-sm text-green-500" />
                <div class="min-w-0">
                    <div class="text-base font-bold text-gray-800 dark:text-gray-100">{{this.received}}</div>
                    <div class="truncate text-xs text-gray-500 dark:text-gray-400">{{t "status.received"}}</div>
                </div>
            </div>
            <div class="flex min-w-0 items-center gap-2 rounded-md bg-gray-50 px-3 py-2 dark:bg-gray-900">
                <FaIcon @icon="ban" class="shrink-0 text-sm text-gray-400" />
                <div class="min-w-0">
                    <div class="text-base font-bold text-gray-800 dark:text-gray-100">{{this.cancelled}}</div>
                    <div class="truncate text-xs text-gray-500 dark:text-gray-400">{{t "status.cancelled"}}</div>
                </div>
            </div>
        </div>

        <div class="pallet-widget-scroll-body p-0">
            {{#each this.recentOrders as |order|}}
                <div class="flex items-center justify-between gap-3 border-b border-gray-50 px-3 py-2 hover:bg-gray-50 dark:border-gray-800 dark:hover:bg-gray-800/50">
                    <div class="flex min-w-0 flex-col">
                        <span class="truncate text-xs font-medium text-gray-800 dark:text-gray-100">{{n-a order.public_id}}</span>
                        <span class="truncate text-xs text-gray-400">{{n-a order.supplier_name}}</span>
                    </div>
                    <Badge @status={{order.status}} class="shrink-0 text-xs" />
                </div>
            {{else}}
                <div class="pallet-widget-empty">No recent purchase orders.</div>
            {{/each}}
        </div>
    {{/if}}
</div>
