<div class="pallet-dashboard-widget flex h-full min-h-0 flex-col overflow-hidden rounded-md border bg-white shadow-sm dark:bg-gray-800" ...attributes>
    <div class="pallet-widget-header">
        <div>
            <div class="pallet-widget-title">Warehouse Utilization</div>
            <div class="pallet-widget-subtitle">Units, available stock, and reservations by warehouse</div>
        </div>
        <FaIcon @icon="warehouse" class="text-gray-400" />
    </div>
    <div class="pallet-widget-scroll-body">
        {{#if this.error}}
            <div class="pallet-widget-empty">{{this.error}}</div>
        {{else if this.load.isRunning}}
            <div class="pallet-widget-empty"><Spinner /></div>
        {{else if (eq this.rows.length 0)}}
            <div class="pallet-widget-empty">No warehouse inventory yet.</div>
        {{else}}
            <div class="space-y-3">
                {{#each this.rows as |warehouse|}}
                    <div>
                        <div class="mb-1 flex items-center justify-between gap-2">
                            <span class="truncate text-xs font-semibold text-gray-700 dark:text-gray-200">{{warehouse.name}}</span>
                            <span class="shrink-0 text-xs text-gray-500 dark:text-gray-400">{{warehouse.available_units}} / {{warehouse.units}} units</span>
                        </div>
                        <div class="grid grid-cols-10 gap-0.5">
                            {{#each warehouse.filledSegments}}
                                <div class="h-2 rounded-full bg-sky-500"></div>
                            {{/each}}
                            {{#each warehouse.emptySegments}}
                                <div class="h-2 rounded-full bg-gray-100 dark:bg-gray-700"></div>
                            {{/each}}
                        </div>
                    </div>
                {{/each}}
            </div>
        {{/if}}
    </div>
</div>
