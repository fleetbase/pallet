<div class="pallet-dashboard-widget flex h-full min-h-0 flex-col overflow-hidden rounded-md border bg-white shadow-sm dark:bg-gray-800" ...attributes>
    <div class="pallet-widget-header">
        <div>
            <div class="pallet-widget-title">{{t "widgets.titles.expiring-stock"}}</div>
            <div class="pallet-widget-subtitle">Inventory lots expiring within 30 days</div>
        </div>
        <FaIcon @icon="calendar-xmark" class="text-gray-400" />
    </div>
    <div class="pallet-widget-scroll-body p-0">
        {{#if this.loadExpiringStock.isRunning}}
            <div class="pallet-widget-empty"><Spinner /></div>
        {{else if this.error}}
            <div class="pallet-widget-empty">{{this.error}}</div>
        {{else if (eq this.items.length 0)}}
            <div class="pallet-widget-empty">
                <div>
                    <FaIcon @icon="calendar-check" class="mb-2 text-2xl text-green-400" />
                    <div>No stock expiring within 30 days</div>
                </div>
            </div>
        {{else}}
            <table class="w-full text-xs">
                <thead class="sticky top-0 bg-white dark:bg-gray-900 z-10">
                    <tr class="border-b border-gray-100 dark:border-gray-700 text-gray-500 dark:text-gray-400">
                        <th class="text-left px-3 py-2 font-medium">{{t "widgets.labels.product"}}</th>
                        <th class="text-right px-3 py-2 font-medium">{{t "widgets.labels.qty"}}</th>
                        <th class="text-right px-3 py-2 font-medium">{{t "widgets.labels.expires"}}</th>
                    </tr>
                </thead>
                <tbody>
                    {{#each this.items as |item|}}
                        <tr class="border-b border-gray-50 dark:border-gray-800 hover:bg-gray-50 dark:hover:bg-gray-800/50">
                            <td class="px-3 py-2 font-medium text-gray-800 dark:text-gray-100 truncate max-w-[120px]">
                                {{n-a item.product_name}}
                                {{#if item.lot_number}}
                                    <span class="text-gray-400 font-normal"> · {{item.lot_number}}</span>
                                {{/if}}
                            </td>
                            <td class="px-3 py-2 text-right text-gray-600 dark:text-gray-300">{{item.quantity}}</td>
                            <td class="px-3 py-2 text-right">
                                {{#let (this.daysUntilExpiry item.expiry_date) as |days|}}
                                    <span class="px-1.5 py-0.5 rounded text-xs font-medium {{this.expiryBadgeClass days}}">
                                        {{days}}d
                                    </span>
                                {{/let}}
                            </td>
                        </tr>
                    {{/each}}
                </tbody>
            </table>
        {{/if}}
    </div>
</div>
