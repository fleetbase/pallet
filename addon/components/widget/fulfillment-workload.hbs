<div class="pallet-dashboard-widget flex h-full min-h-0 flex-col overflow-hidden rounded-md border bg-white shadow-sm dark:bg-gray-800" ...attributes>
    <div class="pallet-widget-header">
        <div>
            <div class="pallet-widget-title">{{t "widgets.titles.fulfillment-workload"}}</div>
            <div class="pallet-widget-subtitle">Open execution queues across warehouse operations</div>
        </div>
        <FaIcon @icon="clipboard-list" class="text-gray-400" />
    </div>
    <div class="pallet-widget-scroll-body">
        {{#if this.error}}
            <div class="pallet-widget-empty">{{this.error}}</div>
        {{else if this.load.isRunning}}
            <div class="pallet-widget-empty"><Spinner /></div>
        {{else}}
            <div class="grid grid-cols-1 gap-2">
                {{#each this.groups as |group|}}
                    <div class="flex items-center justify-between gap-3 rounded-md border border-gray-100 px-3 py-2 dark:border-gray-700">
                        <div class="flex min-w-0 items-center gap-2">
                            <FaIcon @icon={{group.icon}} class="text-gray-400" />
                            <span class="truncate text-sm font-medium text-gray-700 dark:text-gray-200">{{group.label}}</span>
                        </div>
                        <span class="shrink-0 text-sm font-bold text-gray-900 dark:text-white">{{group.total}}</span>
                    </div>
                {{/each}}
            </div>
        {{/if}}
    </div>
</div>
