<div class="flex flex-col h-full overflow-hidden p-3">
    {{#if this.loadStockValue.isRunning}}
        <div class="flex items-center justify-center h-full">
            <Spinner />
        </div>
    {{else if (eq this.warehouses.length 0)}}
        <div class="flex flex-col items-center justify-center h-full text-gray-400 dark:text-gray-600">
            <FaIcon @icon="warehouse" class="text-3xl mb-2" />
            <span class="text-sm">No warehouse data</span>
        </div>
    {{else}}
        <div class="flex items-center justify-between mb-3">
            <span class="text-xs text-gray-500 dark:text-gray-400">Total Stock Value</span>
            <span class="text-sm font-bold text-gray-800 dark:text-gray-100">{{this.totalValue}}</span>
        </div>
        <div class="space-y-3 overflow-y-auto flex-1">
            {{#each this.warehouses as |warehouse|}}
                <div>
                    <div class="flex items-center justify-between mb-1">
                        <span class="text-xs font-medium text-gray-700 dark:text-gray-300 truncate max-w-[60%]">
                            {{n-a warehouse.name}}
                        </span>
                        <span class="text-xs text-gray-500 dark:text-gray-400 ml-2 flex-shrink-0">
                            {{n-a warehouse.value}}
                        </span>
                    </div>
                    <div class="h-2 bg-gray-100 dark:bg-gray-700 rounded-full overflow-hidden">
                        <div class="h-full bg-blue-500 rounded-full transition-all duration-500" style="width: {{this.barWidth warehouse.value}}"></div>
                    </div>
                </div>
            {{/each}}
        </div>
    {{/if}}
</div>