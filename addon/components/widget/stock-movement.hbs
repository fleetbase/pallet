<div class="pallet-dashboard-widget flex h-full min-h-0 flex-col overflow-hidden rounded-md border bg-white shadow-sm dark:bg-gray-800" ...attributes>
    <div class="pallet-widget-header">
        <div>
            <div class="pallet-widget-title">{{t "widgets.titles.stock-movement"}}</div>
            <div class="pallet-widget-subtitle">Movement quantity by transaction type over 14 days</div>
        </div>
        <FaIcon @icon="arrow-trend-up" class="text-gray-400" />
    </div>
    <div class="pallet-widget-scroll-body">
        {{#if this.error}}
            <div class="pallet-widget-empty">{{this.error}}</div>
        {{else if this.load.isRunning}}
            <div class="pallet-widget-empty"><Spinner /></div>
        {{else if (eq this.totals.length 0)}}
            <div class="pallet-widget-empty">No stock movement yet.</div>
        {{else}}
            <div class="flex min-h-0 flex-1 flex-col gap-3">
                <div class="pallet-movement-chart" aria-hidden="true">
                    {{#each this.dailyBars as |day|}}
                        <div class="pallet-movement-bar">
                            <span style={{day.heightStyle}}></span>
                        </div>
                    {{/each}}
                </div>
                <div class="space-y-2">
                    {{#each this.totals as |row|}}
                        <div class="flex items-center justify-between gap-3 rounded-md bg-gray-50 px-3 py-2 dark:bg-gray-900">
                            <span class="truncate text-sm capitalize text-gray-700 dark:text-gray-200">{{row.label}}</span>
                            <span class="shrink-0 text-sm font-bold text-gray-900 dark:text-white">{{row.quantity}}</span>
                        </div>
                    {{/each}}
                </div>
            </div>
        {{/if}}
    </div>
</div>
