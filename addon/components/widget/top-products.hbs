<div class="flex flex-col h-full overflow-hidden p-3">
    {{#if this.isLoading}}
        <div class="flex items-center justify-center h-full">
            <Spinner />
        </div>
    {{else if (eq this.products.length 0)}}
        <div class="flex flex-col items-center justify-center h-full text-gray-400 dark:text-gray-600">
            <FaIcon @icon="arrow-trend-up" class="text-3xl mb-2" />
            <span class="text-sm">No movement data yet</span>
        </div>
    {{else}}
        <div class="space-y-2 overflow-y-auto flex-1">
            {{#each this.products as |product index|}}
                <div class="flex items-center gap-2">
                    <span class="text-xs text-gray-400 dark:text-gray-500 w-4 flex-shrink-0 text-right">
                        {{add index 1}}
                    </span>
                    <div class="flex-1 min-w-0">
                        <div class="flex items-center justify-between mb-0.5">
                            <span class="text-xs font-medium text-gray-700 dark:text-gray-300 truncate">
                                {{n-a product.name}}
                            </span>
                            <span class="text-xs text-gray-500 dark:text-gray-400 ml-2 flex-shrink-0">
                                {{product.movement_count}} moves
                            </span>
                        </div>
                        <div class="h-1.5 bg-gray-100 dark:bg-gray-700 rounded-full overflow-hidden">
                            <div
                                class="h-full bg-indigo-500 rounded-full transition-all duration-500"
                                style="width: {{this.barWidth product.movement_count}}"
                            ></div>
                        </div>
                    </div>
                </div>
            {{/each}}
        </div>
    {{/if}}
</div>
