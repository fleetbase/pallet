<Overlay
    @onLoad={{this.setOverlayContext}}
    @position="right"
    @noBackdrop={{true}}
    @fullHeight={{true}}
    @isResizable={{or this.isResizable @isResizable}}
    @width={{or this.width @width "600px"}}
>
    <Overlay::Header
        @title={{if this.stockAdjustment.public_id this.stockAdjustment.name "Make Stock Adjustment"}}
        @status={{this.stockAdjustment.public_id}}
        @hideStatusDot={{true}}
        @createdAt={{this.stockAdjustment.createdAt}}
        @titleWrapperClass="leading-5"
    >
        <:actions>
            <Button
                @icon={{if this.stockAdjustment.id "save" "check"}}
                @type="primary"
                @text={{if this.stockAdjustment.id "Save Stock Adjustment" "Make Stock Adjustment"}}
                @onClick={{perform this.saveTask}}
                @wrapperClass="mr-2"
                @isLoading={{this.saveTask.isRunning}}
                @disabled={{this.saveTask.isRunning}}
            />
            {{#if this.stockAdjustment.id}}
                <Button @type="default" @icon="inventory" @helpText="View inventory details" @onClick={{this.onViewDetails}} @wrapperClass="mr-2" />
            {{/if}}
            <Button @type="default" @icon="times" @helpText={{if this.stockAdjustment.id "Cancel edit stock adjustment" "Cancel add stock adjustment"}} @onClick={{this.onPressCancel}} />
        </:actions>
    </Overlay::Header>

    <Overlay::Body @wrapperClass="new-service-rate-overlay-body px-4 space-y-4 pt-4" @increaseInnerBodyHeightBy={{1000}}>
        <div class="grid grid-cols-1 gap-2 text-xs dark:text-gray-100">
            <InputGroup @name="Product">
                <ModelSelect
                    @modelName="pallet-product"
                    @selectedModel={{this.stockAdjustment.product}}
                    @placeholder="Select product"
                    @triggerClass="form-select form-input"
                    @infiniteScroll={{false}}
                    @renderInPlace={{true}}
                    @onChange={{this.setProduct}}
                    as |product|
                >
                    {{product.name}}
                </ModelSelect>
            </InputGroup>

            {{#if this.hasProductVariants}}
                <InputGroup @name="Variant">
                    <div class="fleetbase-model-select fleetbase-power-select ember-model-select">
                        <PowerSelect
                            @options={{this.stockAdjustment.product.variants}}
                            @selected={{find-by "uuid" this.stockAdjustment.variant_uuid this.stockAdjustment.product.variants}}
                            @onChange={{this.setVariant}}
                            @placeholder="Select variant"
                            @triggerClass="form-select form-input"
                            as |variant|
                        >
                            {{or variant.display_name variant.name variant.sku}}
                        </PowerSelect>
                    </div>
                </InputGroup>
            {{/if}}

            <InputGroup @name="Warehouse">
                <ModelSelect
                    @modelName="warehouse"
                    @selectedModel={{this.stockAdjustment.warehouse}}
                    @placeholder="Select warehouse"
                    @triggerClass="form-select form-input"
                    @infiniteScroll={{false}}
                    @renderInPlace={{true}}
                    @onChange={{this.setWarehouse}}
                    as |warehouse|
                >
                    {{warehouse.name}}
                </ModelSelect>
            </InputGroup>

            <InputGroup @name="Type">
                <div class="fleetbase-model-select fleetbase-power-select ember-model-select">
                    <PowerSelect
                        @options={{this.stockAdjustmentTypeOptions}}
                        @selected={{this.selectedTypeOption}}
                        @onChange={{this.setType}}
                        @placeholder="Select stock adjustment type"
                        @triggerClass="form-select form-input"
                        as |option|
                    >
                        {{option.label}}
                    </PowerSelect>
                </div>
            </InputGroup>
            <InputGroup @name={{this.quantityLabel}} @type="number" @value={{this.stockAdjustment.quantity}} />
            <InputGroup @name="Stock Adjustment Reason">
                <Textarea @value={{this.stockAdjustment.reason}} aria-label="Reason" class="w-full form-input" placeholder="Reason" rows={{5}} />
            </InputGroup>
            <InputGroup @name="Approval">
                <Checkbox @checked={{this.stockAdjustment.approval_required}} @onChange={{fn (mut this.stockAdjustment.approval_required)}}>
                    Requires approval
                </Checkbox>
            </InputGroup>
        </div>
    </Overlay::Body>
</Overlay>