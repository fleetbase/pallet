<div class="text-xs" ...attributes {{did-insert (perform this.load)}}>
    {{#if this.load.isRunning}}
        <div class="py-2 text-gray-400">{{t "common.loading"}}</div>
    {{else if this.adjustments.length}}
        <table class="w-full text-xs dark:text-gray-100">
            <thead>
                <tr class="border-b border-gray-200 text-left whitespace-nowrap text-gray-500 uppercase dark:border-gray-700">
                    <th class="px-3 py-2 font-medium">{{t "inventory.ledger.when"}}</th>
                    <th class="px-3 py-2 font-medium">{{t "common.type"}}</th>
                    <th class="px-3 py-2 text-right font-medium">{{t "inventory.adjustments.before"}}</th>
                    <th class="px-3 py-2 text-right font-medium">{{t "inventory.adjustments.after"}}</th>
                    <th class="px-3 py-2 font-medium">{{t "inventory.adjustments.reason"}}</th>
                </tr>
            </thead>
            <tbody>
                {{#each this.adjustments as |adjustment|}}
                    <tr class="border-b border-gray-100 dark:border-gray-800">
                        <td class="px-3 py-2 whitespace-nowrap">{{n-a (format-date adjustment.created_at)}}</td>
                        <td class="px-3 py-2">
                            {{smart-humanize adjustment.type}}
                            {{#if adjustment.approval_required}}
                                {{! Awaiting approval has not moved stock yet, and the row should say so. }}
                                <Badge @type="yellow" @hideStatusDot={{true}} class="ml-1">{{t "inventory.adjustments.pending"}}</Badge>
                            {{/if}}
                        </td>
                        <td class="px-3 py-2 text-right tabular-nums">{{n-a adjustment.before_quantity}}</td>
                        <td class="px-3 py-2 text-right tabular-nums">{{n-a adjustment.after_quantity}}</td>
                        <td class="px-3 py-2">{{n-a adjustment.reason}}</td>
                    </tr>
                {{/each}}
            </tbody>
        </table>
    {{else}}
        <div class="py-1 text-gray-400">{{t "inventory.adjustments.empty"}}</div>
    {{/if}}
</div>