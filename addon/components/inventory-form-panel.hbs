<Overlay
    @onLoad={{this.setOverlayContext}}
    @position="right"
    @noBackdrop={{true}}
    @fullHeight={{true}}
    @isResizable={{or this.isResizable @isResizable}}
    @width={{or this.width @width "920px"}}
>
    <Overlay::Header
        @title={{if this.inventory.public_id this.inventory.name "Add Inventory"}}
        @status={{this.inventory.public_id}}
        @hideStatusDot={{true}}
        @createdAt={{this.inventory.createdAt}}
        @titleWrapperClass="leading-5"
    >
        <:actions>
            <Button
                @icon={{if this.inventory.id "save" "check"}}
                @type="primary"
                @text={{if this.inventory.id "Save Inventory" "Add Inventory"}}
                @onClick={{perform this.saveTask}}
                @wrapperClass="mr-2"
                @isLoading={{this.saveTask.isRunning}}
                @disabled={{this.saveTask.isRunning}}
            />
            {{#if this.inventory.id}}
                <Button @type="default" @icon="inventory" @helpText="View inventory details" @onClick={{this.onViewDetails}} @wrapperClass="mr-2" />
            {{/if}}
            <Button @type="default" @icon="times" @helpText={{if this.inventory.id "Cancel edit inventory" "Cancel add inventory"}} @onClick={{this.onPressCancel}} />
        </:actions>
    </Overlay::Header>

    {{!
        The create overlay used to carry its own copy of the whole inventory form:
        hardcoded English labels, no permission checks, no lot or serial number, and
        a status list borrowed from fuel reports ("draft", "pending-approval") that
        inventory has never used. It now renders the same form the edit view does,
        the way product-form-panel already did.
    }}
    <Overlay::Body @wrapperClass="new-service-rate-overlay-body px-4 pt-4" @increaseInnerBodyHeightBy={{700}}>
        <Inventory::Form @resource={{this.inventory}} />
    </Overlay::Body>
</Overlay>