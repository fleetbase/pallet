<div class="pallet-product-storefront-cell" ...attributes>
    <Badge @status={{this.badgeStatus}} @hideStatusDot={{true}}>{{this.label}}</Badge>
    {{#if this.product.storefront_product_uuid}}
        <ClickToCopy @value={{this.product.storefront_product_uuid}} class="pallet-product-storefront-cell__id">
            {{this.shortStorefrontId}}
        </ClickToCopy>
    {{else}}
        <span class="pallet-product-storefront-cell__id">No Storefront link</span>
    {{/if}}
</div>
