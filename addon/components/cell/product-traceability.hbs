<div class="pallet-product-flags-cell" ...attributes>
    {{#if this.hasFlags}}
        {{#if this.product.is_serialized}}
            <span>Serialized</span>
        {{/if}}
        {{#if this.product.is_lot_tracked}}
            <span>Lot tracked</span>
        {{/if}}
        {{#if this.product.is_perishable}}
            <span>Perishable</span>
        {{/if}}
        {{#if this.product.requires_quality_check}}
            <span>QC required</span>
        {{/if}}
    {{else}}
        <span class="muted">Standard tracking</span>
    {{/if}}
</div>
