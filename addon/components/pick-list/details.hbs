<div class="details-wrapper" ...attributes>
    <ContentPanel @title={{t "operations.pick-lists.sections.details"}} @open={{true}} @wrapperClass="bordered-top">
        <div class="text-xs">
            <div class="pallet-field-group-heading">{{t "inventory.groups.identity"}}</div>
            <div class="field-info-container field-vertical-container dashed-bottom">
                <div class="field-name">{{t "common.id"}}</div>
                <ClickToCopy @value={{@resource.public_id}} class="field-value font-mono">{{n-a @resource.public_id}}</ClickToCopy>
            </div>
            <div class="field-info-container field-vertical-container dashed-bottom">
                <div class="field-name">{{t "operations.pick-lists.columns.pick-list"}}</div>
                <ClickToCopy @value={{@resource.pick_list_number}} class="field-value font-mono">{{n-a @resource.pick_list_number}}</ClickToCopy>
            </div>
            <div class="field-info-container field-vertical-container dashed-bottom">
                <div class="field-name">{{t "common.status"}}</div>
                <div class="field-value"><Badge @status={{@resource.status}}>{{smart-humanize @resource.status}}</Badge></div>
            </div>
            <div class="field-info-container field-vertical-container">
                <div class="field-name">{{t "operations.common.priority"}}</div>
                <div class="field-value tabular-nums">{{n-a @resource.priority}}</div>
            </div>

            <div class="pallet-field-group-heading">{{t "operations.pick-lists.groups.assignment"}}</div>
            <div class="field-info-container field-vertical-container dashed-bottom">
                <div class="field-name">{{t "operations.common.warehouse"}}</div>
                <div class="field-value">{{n-a @resource.warehouse.name}}</div>
            </div>
            <div class="field-info-container field-vertical-container dashed-bottom">
                <div class="field-name">{{t "operations.pick-lists.wave"}}</div>
                <div class="field-value font-mono">{{n-a @resource.wave.wave_number}}</div>
            </div>
            <div class="field-info-container field-vertical-container dashed-bottom">
                <div class="field-name">{{t "operations.pick-lists.columns.assigned-to"}}</div>
                <div class="field-value">{{n-a @resource.assignedTo.name}}</div>
            </div>
            <div class="field-info-container field-vertical-container dashed-bottom">
                <div class="field-name">{{t "operations.pick-lists.started-at"}}</div>
                <div class="field-value">{{n-a (format-date @resource.started_at)}}</div>
            </div>
            <div class="field-info-container field-vertical-container{{if @resource.notes ' dashed-bottom'}}">
                <div class="field-name">{{t "operations.pick-lists.completed-at"}}</div>
                <div class="field-value">{{n-a (format-date @resource.completed_at)}}</div>
            </div>
            {{#if @resource.notes}}
                <div class="field-info-container field-vertical-container">
                    <div class="field-name">{{t "common.notes"}}</div>
                    <div class="field-value">{{@resource.notes}}</div>
                </div>
            {{/if}}
        </div>
    </ContentPanel>

    <ContentPanel @title={{t "operations.pick-lists.sections.progress"}} @open={{true}} @wrapperClass="bordered-top">
        <div class="grid grid-cols-2 gap-3 text-xs sm:grid-cols-4">
            <div class="field-info-container">
                <div class="field-name">{{t "operations.pick-lists.fields.lines-picked"}}</div>
                <div class="field-value tabular-nums">{{this.picking.linesComplete}}<span class="text-gray-400"> / {{this.picking.lines}}</span></div>
            </div>
            <div class="field-info-container">
                <div class="field-name">{{t "operations.pick-lists.columns.requested"}}</div>
                <div class="field-value tabular-nums">{{format-number this.picking.requested}}</div>
            </div>
            <div class="field-info-container">
                <div class="field-name">{{t "operations.pick-lists.columns.picked"}}</div>
                <div class="field-value tabular-nums">{{format-number this.picking.picked}}</div>
            </div>
            <div class="field-info-container">
                <div class="field-name">{{t "operations.pick-lists.fields.outstanding"}}</div>
                <div class="field-value tabular-nums">
                    <span class={{if this.picking.outstanding "text-amber-600 dark:text-amber-300"}}>{{format-number this.picking.outstanding}}</span>
                </div>
            </div>
        </div>
    </ContentPanel>

    {{!
        Walk order, not database order — the sequence is what turns a set of lines into
        a route through the building, so the sort is the point of the panel.
    }}
    <ContentPanel @title={{t "operations.pick-lists.sections.route"}} @open={{true}} @wrapperClass="bordered-top" @panelBodyWrapperClass="px-0i">
        {{#if this.lines.length}}
            <table class="w-full text-xs dark:text-gray-100">
                <thead>
                    <tr class="whitespace-nowrap border-b border-gray-200 text-left uppercase text-gray-500 dark:border-gray-700">
                        <th class="w-12 px-3 py-2 text-right">{{t "operations.pick-lists.fields.sequence"}}</th>
                        <th class="px-3 py-2">{{t "operations.common.location"}}</th>
                        <th class="w-1/3 px-3 py-2">{{t "columns.product"}}</th>
                        <th class="px-3 py-2">{{t "common.status"}}</th>
                        <th class="px-3 py-2 text-right">{{t "operations.pick-lists.columns.requested"}}</th>
                        <th class="px-3 py-2 text-right">{{t "operations.pick-lists.columns.picked"}}</th>
                        <th class="px-3 py-2 text-right">{{t "operations.pick-lists.fields.outstanding"}}</th>
                    </tr>
                </thead>
                <tbody>
                    {{#each this.lines as |line|}}
                        <tr class="border-b border-gray-100 dark:border-gray-800">
                            <td class="px-3 py-2 text-right tabular-nums text-gray-400">{{n-a line.item.sequence_number}}</td>
                            <td class="px-3 py-2 font-mono">{{n-a line.item.binLocation.bin_number}}</td>
                            <td class="px-3 py-2">
                                <div class="truncate font-medium text-gray-700 dark:text-gray-200">{{n-a line.item.product.name}}</div>
                                <div class="truncate text-gray-400">{{n-a (or line.item.lot_number line.item.product.sku)}}</div>
                            </td>
                            <td class="px-3 py-2"><Badge @status={{line.item.status}}>{{smart-humanize line.item.status}}</Badge></td>
                            <td class="px-3 py-2 text-right tabular-nums">{{format-number line.requested}}</td>
                            <td class="px-3 py-2 text-right tabular-nums">{{format-number line.picked}}</td>
                            <td class="px-3 py-2 text-right tabular-nums">
                                <span class={{if line.outstanding "text-amber-600 dark:text-amber-300"}}>{{format-number line.outstanding}}</span>
                            </td>
                        </tr>
                    {{/each}}
                </tbody>
            </table>
        {{else}}
            <div class="px-3 py-6 text-xs text-gray-500 dark:text-gray-400">{{t "operations.pick-lists.no-items"}}</div>
        {{/if}}
    </ContentPanel>

    <ContentPanel @title={{t "common.metadata"}} @open={{false}} @wrapperClass="bordered-top" @panelBodyWrapperClass={{unless (is-object-empty @resource.meta) "px-0i" ""}}>
        <MetadataViewer @metadata={{@resource.meta}} />
    </ContentPanel>
</div>
